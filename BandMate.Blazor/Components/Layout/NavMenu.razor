            <AuthorizeView>
                <Authorized>
                    <div class="nav-item pb-4 px-3">
                        <NavLink class="nav-link" href="song/list">
                            Song Catalog
                        </NavLink>
                    </div>
                    <div class="nav-item dropdown">
