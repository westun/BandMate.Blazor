<div class="@(IsCenteredXAndY ? "spinner-center" : "")">
    <div class="d-flex @(IsCentered ? "justify-content-center" : "") align-items-center w-100 my-5">
        <Spinner Type="SpinnerType.Dots"
                 Color="SpinnerColor.Primary"
                 Size="SpinnerSize.ExtraLarge" />
    </div>
</div>

@code {
    [Parameter]
    public bool IsCentered { get; set; }

    [Parameter]
    public bool IsCenteredXAndY { get; set; } = true;
}