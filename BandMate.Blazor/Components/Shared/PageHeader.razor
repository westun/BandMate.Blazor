<div class="row @(UseStandardBottomMargin ? "mb-4" : "")  pb-2">
    <div class="col text-center">
        <h1 class="display-6 fw-bold">
            @if (string.IsNullOrWhiteSpace(Title))
            {
                <span class="text-muted opacity-50">No Band Selected</span>
            }
            else
            {
                @Title
            }
        </h1>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public bool UseStandardBottomMargin { get; set; } = true;
}