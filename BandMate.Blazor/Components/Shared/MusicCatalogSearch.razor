@using System.ComponentModel.DataAnnotations
@using BandMate.MusicCatalog.Models
@using BandMate.MusicCatalog.Persistence
@rendermode InteractiveServer
@inject IBandService BandService
@inject IArtistRepository ArtistRepository

@if (this.IsLoading)
{
    <div class="mb-3">
        <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Size="SpinnerSize.ExtraLarge" />
    </div>
}
else
{
    <h1 class="text-center">Music Catalog Search</h1>
    <EditForm Model="SearchRequest" OnValidSubmit="() => this.OnSearchForArtist()" autocomplete="on">
        <DataAnnotationsValidator />
        <div class="row row-cols-lg-auto g-3 align-items-center">
            <div class="col-12">
                <label class="form-label">Search Artist:</label>
            </div>
            <div class="col-12">
                <TextInput @bind-Value="SearchRequest.Criteria" />
                <ValidationMessage For="@(() => SearchRequest.Criteria)" />
            </div>
            <div class="col-12">
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Search</Button>
            </div>
        </div>
    </EditForm>

    @if (this.CurrentView == MusicCatalogView.Artists)
    {
        <div class="row mt-3">
            <p>
                <span class="fs-3">Select an artist:</span>
            </p>
            @foreach (var artist in this.ArtistSearchResults)
            {
                <div class="col-md-6" @key="artist.Id" @onclick="() => this.OnSelectArtist(artist)">
                    <div style="cursor:pointer;" class="card mb-3">
                        <img src="@artist.ImageUrl" class="card-img-top" alt="Band Name">
                        <div class="card-body">
                            <h5 class="card-title">@artist.Name</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (this.CurrentView == MusicCatalogView.Albums)
    {
        <div class="row mt-3">
            <p>
                <Button Color="ButtonColor.Info" @onclick="() => NavigateBackToArtistView()">
                    <span class="bi bi-arrow-left-circle"></span>
                    Go Back To Artists
                </Button>
            </p>
            <p>
                <span class="fs-3">Artist: <strong>@this.SelectedArtist.Name</strong></span>
            </p>
            <p>
                <span class="fs-4">Select an album:</span>
            </p>
            @foreach (var album in this.AlbumSearchResults)
            {
                <div class="col-md-4" @key="album.Id" @onclick="() => this.OnSelectAlbum(album)"">
                    <div style="cursor:pointer;" class="card mb-3">
                        <img src="@album.AlbumImgCoverUrl" class="card-img-top" alt="Band Name">
                        <div class="card-body">
                            <h5 class="card-title">@album.Name</h5>
                            <p class="card-text">Release Date: @album.Release_Date</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (this.CurrentView == MusicCatalogView.TracksByAlbum)
    {
        <div class="row mt-3">
            <p>
                <Button Color="ButtonColor.Info" @onclick="() => NavigateBackToAlbumView()">
                    <span class="bi bi-arrow-left-circle"></span>
                    Go Back To Albums
                </Button>
            </p>
            <p>
                <span class="fs-3">Artist: <strong>@this.SelectedArtist.Name</strong></span>
            </p>
            <p>
                <span class="fs-4">Album: <strong>@this.SelectedAlbum.Name</strong></span>
            </p>
            <div class="mb-2">
                <img src="@SelectedAlbum.AlbumImgCoverUrl" />
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Track Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in this.SelectedAlbum.Tracks)
                    {
                        <tr @key="track.Id">
                            <th scope="row">@track.Track_Number</th>
                            <td>
                                <Button Type="ButtonType.Link" @onclick="() => OnSelectTrack(track)">
                                    @track.Name
                                </Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int CurrentBandID { get; set; } = 0;
    private BandDTO CurrentBand { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private MusicSearchRequest SearchRequest { get; set; } = new();

    IEnumerable<Artist> ArtistSearchResults { get; set; } = Enumerable.Empty<Artist>();
    IEnumerable<Album> AlbumSearchResults { get; set; } = Enumerable.Empty<Album>();

    private MusicCatalogView CurrentView { get; set; } = MusicCatalogView.Empty;

    private Artist SelectedArtist { get; set; } = new();
    private Album SelectedAlbum { get; set; } = new();

    [Parameter] 
    public EventCallback<SongDTO> OnTrackSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await this.GetCurrentAccountID();

        this.CurrentBand = await this.BandService.GetDefaultBand(currentAccountID);
        this.CurrentBandID = this.CurrentBand?.BandID ?? 0;

        this.IsLoading = false;
    }

    private async Task<int> GetCurrentAccountID()
    {
        var authState = await this.AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var accountIDClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountID");
            if (accountIDClaim != null && int.TryParse(accountIDClaim.Value, out int accountID))
            {
                return accountID;
            }
        }
        return 0;
    }

    private async Task OnSearchForArtist()
    {
        this.ToggleLoadingState(loading: true);

        this.ClearSearchResults();

        this.ArtistSearchResults = await this.ArtistRepository.SearchArtistsAsync(this.SearchRequest.Criteria);

        this.CurrentView = MusicCatalogView.Artists;

        this.ToggleLoadingState(loading: false);
    }

    private async Task OnSelectArtist(Artist artist)
    {
        this.ToggleLoadingState(loading: true);

        this.SelectedArtist = artist;

        this.AlbumSearchResults = await this.ArtistRepository.GetAlbums(artist.Id);

        this.CurrentView = MusicCatalogView.Albums;

        this.ToggleLoadingState(loading: false);
    }

    private void ToggleLoadingState(bool loading)
    {
        this.IsLoading = loading;
        this.StateHasChanged();
    }

    private void ClearSearchResults()
    {
        this.ArtistSearchResults = Enumerable.Empty<Artist>();
        this.AlbumSearchResults = Enumerable.Empty<Album>();
        this.SelectedArtist = new();
        this.SelectedAlbum = new();
    }

    private async Task OnSelectAlbum(Album album)
    {
        this.SelectedAlbum = album;
        this.CurrentView = MusicCatalogView.TracksByAlbum;
    }

    private async Task NavigateBackToArtistView()
    {
        this.SelectedArtist = new();
        this.AlbumSearchResults = Enumerable.Empty<Album>();
        this.CurrentView = MusicCatalogView.Artists;
    }

    private async Task NavigateBackToAlbumView()
    {
        this.SelectedAlbum = new();
        this.CurrentView = MusicCatalogView.Albums;
    }

    private async Task OnSelectTrack(Song track)
    {
        await OnTrackSelected.InvokeAsync(new SongDTO
        {
            Artist = this.SelectedArtist.Name,
            Title = track.Name,
        });
    }

    public class MusicSearchRequest
    {
        [Required(ErrorMessage = "Search Criteria is required")]
        public string Criteria { get; set; } = string.Empty;
    }
}
