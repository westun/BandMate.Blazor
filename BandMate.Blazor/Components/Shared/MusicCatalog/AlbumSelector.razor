@using BandMate.MusicCatalog.Models
<div class="row mt-3">
    <p>
        <span class="fs-3">Artist: <strong>@ArtistName</strong></span>
    </p>
    
    <div class="row row-cols-lg-auto align-items-center mb-2">
        <div class="col-12">
            <label class="form-label">Search for album:</label>
        </div>
        <div class="col-12">
            <TextInput @bind-Value="SearchCriteria" @oninput="OnSearchChanged" />
        </div>
    </div>

    <div class="mt-3">
        <span class="fs-4">Select an album:</span>
    </div>

    <MediaCardGrid TItem="Album"
                   Items="FilteredAlbums"
                   GetId="a => a.Id"
                   GetName="a => a.Name"
                   GetImageUrl="a => a.AlbumImgCoverUrl"
                   ShowSubtext="true"
                   GetSubtext='a => $"Released: {a.Release_Date}"'
                   OnSelect="OnAlbumSelected" />
</div>

@code {
    [Parameter] public string ArtistName { get; set; } = string.Empty;
    [Parameter] public IEnumerable<Album> FilteredAlbums { get; set; } = [];
    [Parameter] public string SearchCriteria { get; set; } = string.Empty;
    
    [Parameter] public EventCallback<ChangeEventArgs> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<Album> OnAlbumSelected { get; set; }
}
