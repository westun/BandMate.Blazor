<div class="mt-3">
    @if (CurrentView == MusicCatalogView.Tracks || CurrentView == MusicCatalogView.Albums)
    {
        <p>
            <Button Color="ButtonColor.Info" @onclick="OnBackToArtists">
                <span class="bi bi-arrow-left-circle"></span> Go Back To Artists
            </Button>
        </p>
    }
    else if (CurrentView == MusicCatalogView.TracksByAlbum)
    {
        <p>
            <Button Color="ButtonColor.Info" @onclick="OnBackToAlbums">
                <span class="bi bi-arrow-left-circle"></span> Go Back To Albums
            </Button>
        </p>
    }

    @if (CurrentView == MusicCatalogView.Albums || CurrentView == MusicCatalogView.Tracks)
    {
        <div class="fs-4">Filter tracks by:</div>
        <Tabs EnableFadeEffect="false" NavStyle="NavStyle.Pills" Class="mb-3">
            @foreach (var item in NavItems)
            {
                <Tab @key="item.Name" Title="@item.Name" OnClick="() => OnViewChanged.InvokeAsync(item)" />
            }
        </Tabs>
    }
</div>

@code {
    [Parameter] public MusicCatalogView CurrentView { get; set; }
    [Parameter] public List<SubViewNavItem> NavItems { get; set; } = new();
    [Parameter] public EventCallback OnBackToArtists { get; set; }
    [Parameter] public EventCallback OnBackToAlbums { get; set; }
    [Parameter] public EventCallback<SubViewNavItem> OnViewChanged { get; set; }
}
