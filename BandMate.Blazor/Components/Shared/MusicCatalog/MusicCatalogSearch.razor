@using System.ComponentModel.DataAnnotations
@using BandMate.MusicCatalog.Models
@using BandMate.MusicCatalog.Persistence
@rendermode InteractiveServer
@inject IBandService BandService
@inject IArtistRepository ArtistRepository

@if (IsLoading)
{
    <LoadingSpinner IsCentered="true" />
}
else
{
    <PageHeader Title="Music Catalog Search" />

    <ArtistSearchForm Request="SearchRequest" 
                      OnSearch="OnSearchForArtist" />

    @if (CurrentView == MusicCatalogView.Artists)
    {
        <div class="row mt-3">
            <p>
                <span class="fs-3">Select an artist:</span>
            </p>
            @foreach (var artist in ArtistSearchResults)
            {
                <div class="col-md-6" @key="artist.Id" @onclick="() => OnSelectArtist(artist)">
                    <div style="cursor:pointer;" class="card mb-3">
                        <img src="@artist.ImageUrl" class="card-img-top" alt="Band Name">
                        <div class="card-body">
                            <h5 class="card-title">@artist.Name</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        @if (CurrentView == MusicCatalogView.Tracks || CurrentView == MusicCatalogView.Albums)
        {
            <p>
                <Button Color="ButtonColor.Info" @onclick="() => NavigateBackToArtistView()">
                    <span class="bi bi-arrow-left-circle"></span>
                    Go Back To Artists
                </Button>
            </p>
        }
        else if (CurrentView == MusicCatalogView.TracksByAlbum)
        {
            <p>
                <Button Color="ButtonColor.Info" @onclick="() => NavigateBackToAlbumView()">
                    <span class="bi bi-arrow-left-circle"></span>
                    Go Back To Albums
                </Button>
            </p>
        }

        @if (CurrentView == MusicCatalogView.Albums || CurrentView == MusicCatalogView.Tracks)
        {
            <div class="fs-4">Filter tracks by:</div>
            <Tabs EnableFadeEffect="false" NavStyle="NavStyle.Pills" Class="mb-3">
                @foreach (var subViewNavItem in SubViewNavItems)
                {
                    <div @key="subViewNavItem.Name">
                        <Tab Title="@subViewNavItem.Name"
                            OnClick="async () => await OnTrackViewSelection(subViewNavItem)">
                            <Content></Content>
                        </Tab>
                    </div>
                }
            </Tabs>
        }
    </div>

    @if (CurrentView == MusicCatalogView.Albums)
    {
        <div class="row mt-3">
            <p>
                <span class="fs-3">Artist: <strong>@SelectedArtist.Name</strong></span>
            </p>
            <div class="row row-cols-lg-auto align-items-center mb-2">
                <div class="col-12">
                    <label class="form-label">Search for album:</label>
                </div>
                <div class="col-12">
                    <TextInput @bind-Value="SearchForAlbumsCriteria" @oninput="OnSearchForAlbums" />
                </div>
            </div>
            <p>
                <span class="fs-4">Select an album:</span>
            </p>
            @foreach (var album in AlbumsFilteredBySearch)
            {
                <div class="col-md-4" @key="album.Id" @onclick="() => OnSelectAlbum(album)" ">
                    <div style="cursor:pointer;" class="card mb-3">
                        <img src="@album.AlbumImgCoverUrl" class="card-img-top" alt="Band Name">
                        <div class="card-body">
                            <h5 class="card-title">@album.Name</h5>
                            <p class="card-text">Release Date: @album.Release_Date</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (CurrentView == MusicCatalogView.TracksByAlbum || CurrentView == MusicCatalogView.Tracks)
    {
        <div class="row mt-3">
            <p>
                <span class="fs-3">Artist: <strong>@SelectedArtist.Name</strong></span>
            </p>
            @if (CurrentView == MusicCatalogView.TracksByAlbum)
            {
                <p>
                    <span class="fs-4">Album: <strong>@SelectedAlbum.Name</strong></span>
                </p>
                <div class="mb-2">
                    <img src="@SelectedAlbum.AlbumImgCoverUrl" />
                </div>
            }
            @if (CurrentView == MusicCatalogView.Tracks)
            {
                <div class="row row-cols-lg-auto align-items-center mb-2">
                    <div class="col-12">
                        <label class="form-label">Search for track:</label>
                    </div>
                    <div class="col-12">
                        <TextInput @bind-Value="SearchForTracksCriteria" @oninput="OnSearchForTrack" />
                    </div>
                </div>
            }
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Track Name</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var tracksToDisplay = new List<Song>();
                        @if (CurrentView == MusicCatalogView.Tracks)
                        {
                            tracksToDisplay = TracksFilteredBySearch;
                        }
                        else
                        {
                            tracksToDisplay = SelectedAlbum.Tracks?.ToList() ?? new List<Song>();
                        }
                    }
                    @foreach (var track in tracksToDisplay)
                    {
                        <tr @key="@(track.Id + "_" + tracksToDisplay.IndexOf(track))"> <!-- the track.Id is not always unique, throws error, make it always unique using index-->
                            <th scope="row">
                                @(CurrentView == MusicCatalogView.Tracks
                                    ? tracksToDisplay.IndexOf(track) + 1
                                    : track.Track_Number)
                            </th>
                            <td>
                                <Button Type="ButtonType.Link" @onclick="() => OnSelectTrack(track)">
                                    @track.Name
                                </Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // --- Parameters & Cascading Values ---
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [Parameter]
    public EventCallback<SongDTO> OnTrackSelected { get; set; }

    // --- Component State & UI Management ---
    private bool IsLoading { get; set; } = true;
    private MusicCatalogView CurrentView { get; set; } = MusicCatalogView.Empty;
    private int CurrentBandID { get; set; } = 0;
    private BandDTO CurrentBand { get; set; } = new();

    // --- Search & Filtering State ---
    private MusicSearchRequestModel SearchRequest { get; set; } = new();
    private string SearchForTracksCriteria { get; set; } = string.Empty;
    private string SearchForAlbumsCriteria { get; set; } = string.Empty;

    // --- Data Collections (Results & Selections) ---
    private IEnumerable<Artist> ArtistSearchResults { get; set; } = Enumerable.Empty<Artist>();
    private IEnumerable<Album> AlbumSearchResults { get; set; } = Enumerable.Empty<Album>();
    
    private Artist SelectedArtist { get; set; } = new();
    private Album SelectedAlbum { get; set; } = new();
    private IEnumerable<Song> SelectedArtistTracks { get; set; } = Enumerable.Empty<Song>();

    // --- Configuration / Static Data ---
    private List<SubViewNavItem> SubViewNavItems { get; set; } = new()
    {
        new SubViewNavItem { Name = "By Album", View = MusicCatalogView.Albums },
        new SubViewNavItem { Name = "By Track", View = MusicCatalogView.Tracks },
    };

    // --- Computed Properties ---
    public List<Song> TracksFilteredBySearch => string.IsNullOrWhiteSpace(SearchForTracksCriteria)
        ? SelectedArtistTracks.ToList()
        : SelectedArtistTracks.Where(t => t.Name.Contains(SearchForTracksCriteria, StringComparison.OrdinalIgnoreCase)).ToList();

    public List<Album> AlbumsFilteredBySearch => string.IsNullOrWhiteSpace(SearchForAlbumsCriteria)
        ? AlbumSearchResults.ToList()
        : AlbumSearchResults.Where(t => t.Name.Contains(SearchForAlbumsCriteria, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await GetCurrentAccountID();

        CurrentBand = await BandService.GetDefaultBand(currentAccountID);
        CurrentBandID = CurrentBand?.BandID ?? 0;

        IsLoading = false;
    }

    private async Task<int> GetCurrentAccountID()
    {
        var authState = await AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var accountIDClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountID");
            if (accountIDClaim != null && int.TryParse(accountIDClaim.Value, out int accountID))
            {
                return accountID;
            }
        }
        return 0;
    }

    // --- Search & Selection Actions ---
    private async Task OnSearchForArtist()
    {
        ToggleLoadingState(loading: true);
        ClearSearchResults();
        ArtistSearchResults = await ArtistRepository.SearchArtistsAsync(SearchRequest.Criteria);
        CurrentView = MusicCatalogView.Artists;
        ToggleLoadingState(loading: false);
    }

    private async Task OnSelectArtist(Artist artist)
    {
        ToggleLoadingState(loading: true);
        SelectedArtist = artist;
        AlbumSearchResults = await ArtistRepository.GetAlbums(artist.Id);
        SelectedArtistTracks = AlbumSearchResults
            .SelectMany(a => a.Tracks)
            .OrderBy(t => t.Name)
            .ToList();
        CurrentView = MusicCatalogView.Albums;
        ToggleLoadingState(loading: false);
    }

    private async Task OnSelectAlbum(Album album)
    {
        SelectedAlbum = album;
        SearchForAlbumsCriteria = string.Empty;
        CurrentView = MusicCatalogView.TracksByAlbum;
    }

    private async Task OnSelectTrack(Song track)
    {
        await OnTrackSelected.InvokeAsync(new SongDTO
        {
            Artist = SelectedArtist.Name,
            Title = track.Name,
        });
    }

    // --- Filter & View Logic ---
    private async Task OnTrackViewSelection(SubViewNavItem subViewNavItem)
    {
        CurrentView = subViewNavItem.View;
        SearchForTracksCriteria = string.Empty;
        SearchForAlbumsCriteria = string.Empty;
        StateHasChanged();
    }

    private async Task OnSearchForTrack(ChangeEventArgs e) =>
        SearchForTracksCriteria = e.Value?.ToString() ?? string.Empty;

    private async Task OnSearchForAlbums(ChangeEventArgs e) =>
        SearchForAlbumsCriteria = e.Value?.ToString() ?? string.Empty;

    // --- Navigation ---
    private async Task NavigateBackToArtistView()
    {
        SelectedArtist = new();
        AlbumSearchResults = Enumerable.Empty<Album>();
        CurrentView = MusicCatalogView.Artists;
    }

    private async Task NavigateBackToAlbumView()
    {
        SelectedAlbum = new();
        CurrentView = MusicCatalogView.Albums;
    }

    // --- Private Helpers ---
    private void ToggleLoadingState(bool loading)
    {
        IsLoading = loading;
        StateHasChanged();
    }

    private void ClearSearchResults()
    {
        ArtistSearchResults = Enumerable.Empty<Artist>();
        AlbumSearchResults = Enumerable.Empty<Album>();
        SelectedArtist = new();
        SelectedAlbum = new();
    }

    // --- Classes ---
    public class SubViewNavItem
    {
        public string Name { get; set; }
        public MusicCatalogView View { get; set; }
    }
}