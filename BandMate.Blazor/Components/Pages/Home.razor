@page "/"

<div class="welcome-banner mb-5 rounded-4 shadow-lg overflow-hidden">
    <div class="p-5 text-white bg-dark bg-gradient position-relative">
        <!-- Abstract music pattern overlay -->
        <div class="position-absolute top-0 end-0 p-4 opacity-25">
            <i class="bi bi-vinyl fs-1 d-block rotate-slow"></i>
            <i class="bi bi-mic fs-2 d-block mt-3"></i>
        </div>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 mb-3 text-uppercase tracking-widest">Version 2.0</span>
                <h1 class="display-4 fw-bold mb-3 tracking-tight">Welcome to <span class="text-primary">BandMate</span></h1>
                <p class="lead mb-4 opacity-75">
                    The ultimate command center for your band. Manage setlists, 
                    track upcoming gigs, and vote on new catalog additions—all in one place.
                </p>
                <div class="d-flex gap-3">
                    <button class="btn btn-primary btn-lg px-4 fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Create New Band
                    </button>
                    <button class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-journal-text me-2"></i>View Setlists
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="services" class="py-5 bg-light-subtle">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-12 text-center">
                <h2 class="display-5 fw-bold text-dark mb-3">What can you do here?</h2>
                <div class="mx-auto bg-primary rounded" style="height: 4px; width: 60px;"></div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Gigs -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm hover-lift text-center p-4">
                    <div class="feature-icon-wrapper mb-3">
                        <i class="bi bi-calendar3-event fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-3">See Upcoming Gigs</h4>
                    <p class="text-muted small">
                        Never forget a performance. Access your schedule and venue details instantly on the Gigs page.
                    </p>
                </div>
            </div>

            <!-- Suggestion -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm hover-lift text-center p-4">
                    <div class="feature-icon-wrapper mb-3">
                        <i class="bi bi-music-note-beamed fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Suggest A Song</h4>
                    <p class="text-muted small">
                        Crowdsource your catalog. Let bandmates vote on new tracks—top-rated songs move to the top of your list.
                    </p>
                </div>
            </div>

            <!-- Setlists -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm hover-lift text-center p-4">
                    <div class="feature-icon-wrapper mb-3">
                        <i class="bi bi-clipboard-check fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Create Setlists</h4>
                    <p class="text-muted small">
                        Build and print professional setlists in seconds using your existing catalog or previous templates.
                    </p>
                </div>
            </div>

            <!-- Elections -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm hover-lift text-center p-4">
                    <div class="feature-icon-wrapper mb-3">
                        <i class="bi bi-person-check fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Host Elections</h4>
                    <p class="text-muted small">
                        Keep your setlist fresh with anonymous majority voting to keep or retire songs in your current catalog.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .welcome-banner {
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .tracking-tight { letter-spacing: -0.05em; }
    .tracking-widest { letter-spacing: 0.1em; font-size: 0.7rem; }

    .rotate-slow {
        animation: rotation 8s infinite linear;
    }

    @@keyframes rotation {
        from { transform: rotate(0deg); }
        to { transform: rotate(359deg); }
    }
</style>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
    .feature-icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(13, 110, 253, 0.08);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }
</style>
