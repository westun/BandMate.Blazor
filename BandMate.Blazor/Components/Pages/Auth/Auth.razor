@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView>
    <p>
        Hello @context.User.Identity?.Name!
    </p>
    <h2>Claims</h2>
    @foreach (var claim in context.User.Claims)
    {
        <p>
            @claim.Type: @claim.Value
        </p>
    }
</AuthorizeView>

