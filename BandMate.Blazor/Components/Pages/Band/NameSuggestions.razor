@page "/band/name-suggestions";
@using BandMate.Blazor.Components.Pages.Band.NameSuggestionsComponents
@attribute [Authorize]
@rendermode InteractiveServer
@inject IBandService BandService
@inject IBandNameService BandNameService
@inject IUserService UserService

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Band Name Suggestions" />

    <AddBandNameSuggestionForm OnBandAdded="AddNewBand" />

    @foreach (var bandName in BandNames)
    {
        <BandBadge BandName="@bandName.Name"
                    Rotation="@(Random.Shared.Next(-15, 15))"
                    BgColor="@GetColor(bandName.ID)"
                    ShapeClass="@GetShape(bandName.ID)"
                    Size="@(Random.Shared.Next(90, 120))" />
    }
}

@code {
    private bool IsLoading { get; set; } = true;

    private IEnumerable<BandNameDTO> BandNames { get; set; } = Enumerable.Empty<BandNameDTO>();
    private int CurrentBandID { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await UserService.GetCurrentAccountIDAsync();

        var currentBand = await BandService.GetDefaultBand(currentAccountID);
        CurrentBandID = currentBand?.BandID ?? 0;

        BandNames = await BandNameService.GetAllByBandID(CurrentBandID);

        IsLoading = false;
    }

    private void AddNewBand(string name)
    {
        // var newBandName = 
        // new BandNameDTO { Name = name, BandID = CurrentBandID }

        // Add to your local list
        // BandNames.Add();
        
        StateHasChanged();
    }

    private string GetColor(int id) => (id % 4) switch
    {
        0 => "text-bg-primary",
        1 => "text-bg-warning",
        2 => "text-bg-danger",
        _ => "text-bg-info"
    };

    private string GetShape(int id) => (id % 2 == 0) ? "rounded-circle" : "rounded-3";
}
