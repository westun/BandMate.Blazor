@page "/band/members";
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAccountService AccountService
@inject IBandAccountService BandAccountService
@inject IBandService BandService

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Band Members" />

    @foreach (var member in BandMembers)
    {
        <div @key="member.AccountID">
            <span class="bi bi-person-fill fs-1" aria-hidden="true"></span>
            @member.FirstName @member.LastName
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool IsLoading { get; set; } = true;

    private IEnumerable<AccountDTO> BandMembers = Enumerable.Empty<AccountDTO>();

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await GetCurrentAccountID();

        var currentBand = await BandService.GetDefaultBand(currentAccountID);
        var defaultBandID = currentBand?.BandID ?? 0;

        BandMembers = await AccountService.GetAllByBandID(defaultBandID);

        IsLoading = false;
    }
     
    private async Task<int> GetCurrentAccountID()
    {
        var authState = await AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var accountIDClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountID");
            if (accountIDClaim != null && int.TryParse(accountIDClaim.Value, out int accountID))
            {
                return accountID; 
            }
        }
        return 0;
    }
}
