@page "/band/members";
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAccountService AccountService
@inject IBandAccountService BandAccountService
@inject IBandService BandService
@inject IUserService UserService

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Band Members" />

    <div class="row g-3">
        @foreach (var member in BandMembers)
        {
            <div class="col-md-12" @key="member.AccountID">
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm border-0 bg-light-subtle hover-shadow transition">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-3" 
                                 style="width: 50px; height: 50px;">
                                <span class="bi bi-person-fill fs-3 text-primary"></span>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">@member.FirstName @member.LastName</h6>
                                <small class="text-muted">Band Member</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .transition { transition: all 0.2s ease-in-out; }
    .hover-shadow:hover { 
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

@code {
    private bool IsLoading { get; set; } = true;

    private IEnumerable<AccountDTO> BandMembers = Enumerable.Empty<AccountDTO>();

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await this.UserService.GetCurrentAccountIDAsync();

        var currentBand = await BandService.GetDefaultBand(currentAccountID);
        var defaultBandID = currentBand?.BandID ?? 0;

        BandMembers = await AccountService.GetAllByBandID(defaultBandID);

        IsLoading = false;
    }
}
