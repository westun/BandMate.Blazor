@page "/band/members";
@attribute [Authorize]
@rendermode InteractiveServer
@inject IBandAccountService BandAccountService
@inject IBandService BandService

@if (this.IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Band Members" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<BandDTO> Bands { get; set; } = Enumerable.Empty<BandDTO>().ToList();

    private bool IsLoading { get; set; } = true;
    
    private int DefaultBandID { get; set; }
    private int CurrentAccountID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        this.CurrentAccountID = await this.GetCurrentAccountID();

        this.Bands = (await this.BandService.GetAll(this.CurrentAccountID)).ToList();

        var currentBand = await this.BandService.GetDefaultBand(this.CurrentAccountID);
        this.DefaultBandID = currentBand?.BandID ?? 0;

        this.IsLoading = false;
    }
     
    private async Task<int> GetCurrentAccountID()
    {
        var authState = await this.AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var accountIDClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountID");
            if (accountIDClaim != null && int.TryParse(accountIDClaim.Value, out int accountID))
            {
                return accountID; 
            }
        }
        return 0;
    }
}
