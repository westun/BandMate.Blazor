@page "/band/manage";
@using System.ComponentModel.DataAnnotations
@using BandMate.Blazor.Components.Pages.Band.ManageComponents
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISongListTypeService SongListTypeService
@inject IBandService BandService
@inject IBandAccountService BandAccountService
@inject IUserService UserService

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Manage Band(s)" />

    @if(Bands.Any())
    {
        <SelectBandBanner />
    }
    
    <BandManagementList Bands="Bands" 
                        DefaultBandID="DefaultBandID"
                        OnSelectBandToManage="SaveDefaultBand"/>

    <div class="mt-5 pt-4 border-top">
        <div class="card border-0 bg-light-subtle shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <!-- Left Side: Title & Description -->
                    <div class="col-lg-5 mb-3 mb-lg-0">
                        <div class="d-flex align-items-center mb-2">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                                <i class="bi bi-plus-circle-fill text-primary fs-4"></i>
                            </div>
                            <h3 class="mb-0 fw-bold text-dark">Create a new band</h3>
                        </div>
                        <p class="text-muted mb-0 ps-5 ms-2">Ready to start something new? Enter a name to get started.</p>
                    </div>

                    <!-- Right Side: The Form -->
                    <div class="col-lg-7">
                        <EditForm Model="NewCreateBandRequest" OnValidSubmit="OnCreateBand">
                            <DataAnnotationsValidator />
                            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-lg-end">
                                <div class="flex-grow-1" style="max-width: 400px;">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0">
                                            <i class="bi bi-music-note"></i>
                                        </span>
                                        <TextInput @bind-Value="NewCreateBandRequest.Name"
                                                   class="border-start-0"
                                                   placeholder="Band Name (e.g. The Electric Echoes)" />
                                    </div>
                                    <ValidationMessage For="@(() => NewCreateBandRequest.Name)" class="mt-1 small" />
                                </div>
                                <div>
                                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="px-4 py-2 fw-bold">
                                        <i class="bi bi-plus-lg me-1"></i> Create Band
                                    </Button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<Toasts class="p-3" Messages="ToastMessages" Placement="ToastsPlacement.BottomRight" AutoHide="true" />

@code {
    private List<BandDTO> Bands { get; set; } = Enumerable.Empty<BandDTO>().ToList();

    private bool IsLoading { get; set; } = true;

    private int DefaultBandID { get; set; }
    private int CurrentAccountID { get; set; }

    private CreateBandRequest NewCreateBandRequest { get; set; } = new();

    private List<ToastMessage> ToastMessages { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentAccountID = await UserService.GetCurrentAccountIDAsync();

        Bands = (await BandService.GetAll(CurrentAccountID)).ToList();

        var currentBand = await BandService.GetDefaultBand(CurrentAccountID);
        DefaultBandID = currentBand?.BandID ?? 0;

        IsLoading = false;
    }

    private async Task OnCreateBand()
    {
        var newBand = await BandService
            .CreateAsync(new BandDTO { Name = NewCreateBandRequest.Name }, CurrentAccountID);

        //call set default band method that will set new band to 1 and all other bands to 0
        await SaveDefaultBand(newBand);

        Bands.Add(newBand);

        NewCreateBandRequest.Name = string.Empty;

        ShowToast(ToastType.Success, $"You succesfully create the band: {newBand.Name}");
    }

    private async Task SaveDefaultBand(BandDTO band)
    {
        await BandAccountService.SaveDefaultBandAsync(band.BandID, CurrentAccountID);
        DefaultBandID = band.BandID;

        StateHasChanged();
    }

    private void ShowToast(ToastType type, string message)
    {
        ToastMessages.Add(new ToastMessage { Type = type, Message = message });
    }

    public class CreateBandRequest
    {
        [Required(ErrorMessage = "Band name is required.")]
        [StringLength(100, ErrorMessage = "Name is too long.")]
        public string Name { get; set; } = string.Empty;
    }
}
