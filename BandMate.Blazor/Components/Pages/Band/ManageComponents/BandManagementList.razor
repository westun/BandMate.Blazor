<div class="d-flex flex-column gap-3">
    @foreach (var band in Bands)
    {
        var isDefaultBand = DefaultBandID == band.BandID;

        <div @key="@band.BandID"
             class="card bg-white border-light-subtle shadow-sm transition-all @(isDefaultBand ? "border-primary border-2 shadow-active" : "")">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between py-3">
                <div class="d-flex align-items-center mb-3 mb-md-0">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 border border-primary-subtle">
                        <i class="bi bi-music-note-beamed fs-4 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@band.Name</h5>
                        @if (isDefaultBand)
                        {
                            <span class="badge bg-primary text-dark mt-2 px-2 py-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Active Management
                            </span>
                        }
                        else
                        {
                            <small class="text-muted d-block mt-1 fw-medium">Available to manage</small>
                        }
                    </div>
                </div>

                <!-- Right: Action Buttons -->
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Primary"
                            Size="ButtonSize.Small"
                            Disabled="@isDefaultBand"
                            @onclick="() => OnChooseToManage(band)">
                        <i class="bi bi-play-fill me-1"></i> Manage
                    </Button>
                    
                    <Button Color="ButtonColor.Secondary"
                            Size="ButtonSize.Small"
                            Class="text-dark ">
                        <i class="bi bi-pencil-square me-1 text-dark"></i> Edit
                    </Button>
                    
                    <Button Color="ButtonColor.Danger"
                            Size="ButtonSize.Small">
                        <i class="bi bi-trash3"></i>
                    </Button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] 
    public IEnumerable<BandDTO> Bands { get; set; } = default!;

    [Parameter] 
    public int DefaultBandID { get; set; } = default!;

    [Parameter]
    public EventCallback<BandDTO> OnSelectBandToManage { get; set; }

    private async Task OnChooseToManage(BandDTO band)
    {
        await OnSelectBandToManage.InvokeAsync(band);
    }
}