@page "/bootstrap-grid-demo"
@rendermode InteractiveServer
@using BlazorBootstrap
@using BlazorBootstrap.Components
@inject ISongService SongService
@inject ISongListTypeService SongListTypeService
@inject IBandService BandService

@if (this.IsLoading)
{
    <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Size="SpinnerSize.ExtraLarge" />
}
else
{
    <h1 class="text-center">@this.CurrentBand.Name</h1>
    <h2>@Songs.Count() Songs</h2>

    <Tabs EnableFadeEffect="false" NavStyle="NavStyle.Pills">
        @{ int songListTypeIndex = 0; } @* To set first song type in list to actuve *@
        @foreach (var songListType in this.SongListTypes)
        {
            <Tab Title="@songListType.ListTypeName" 
                 IsActive="@(songListTypeIndex == 0 || songListType.SongListTypeID == this.CurrentSongListTypeID)"
                OnClick="() => OnSongListTypeChanged(songListType.SongListTypeID)">
                <Content></Content>
            </Tab>
            songListTypeIndex++;
        }
    </Tabs>
}

<Grid @ref="CurrentGrid"
    TItem="SongDTO"
    Class="table table-hover table-bordered table-striped"
    DataProvider="SongDataProvider"
    AllowFiltering="false"
    AllowPaging="false"
    AllowSorting="true"
    Responsive="true"
    AllowSelection="true"
    @bind-SelectedItems="this.SelectedSongs"
    SelectionMode="GridSelectionMode.Multiple">

    <GridColumn TItem="SongDTO" HeaderText="Artist" PropertyName="Artist" SortString="Artist" SortKeySelector="item => item.Artist">
        @context.Artist
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Title" PropertyName="Title" SortString="Title" SortKeySelector="item => item.Title">
        @context.Title
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Created Date" PropertyName="CreatedDataForDisplay" SortString="CreatedDataForDisplay" SortKeySelector="item => item.CreatedDate">
        @context.CreatedDateForDisplay
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Bpm" PropertyName="Bpm" SortString="Bpm" SortKeySelector="item => item.Bpm">
        @context.Bpm
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="KeySignature" PropertyName="KeySignature" SortString="KeySignature" SortKeySelector="item => item.KeySignature">
        @context.KeySignature
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Actions">
        <Button Color="ButtonColor.Danger"
                Class="ms-2" 
                @onclick="() => this.OnConfirmRemoveSongClick(context)">
            <Icon Name="IconName.Trash" />
        </Button>
    </GridColumn>

</Grid>

<Modal @ref="RemoveSongModal" Title="Are you sure?" OnHidden="OnHideRemoveSongModalClick">
    <BodyTemplate>
        Are you sure you want to remove the song: <strong>@CurrentSelectedSong?.Title</strong> by <strong>@CurrentSelectedSong?.Artist</strong>?
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideRemoveSongModalClick">Cancel</Button>
        <Button Color="ButtonColor.Danger" @onclick="OnRemoveSelectedSongClick">Remove</Button>
    </FooterTemplate>
</Modal>

@code {
    private IQueryable<SongDTO> Songs { get; set; } = Enumerable.Empty<SongDTO>().AsQueryable();
    private IEnumerable<SongDTO> MasterSongList { get; set; } = Enumerable.Empty<SongDTO>().ToList();
    private int CurrentSongListTypeID { get; set; } = 0;
    private IEnumerable<SongListTypeDTO> SongListTypes { get; set; } = Enumerable.Empty<SongListTypeDTO>().ToList();
    private int currentBandID { get; set; } = 2; //TODO: Get from auth context or url
    private bool IsLoading { get; set; } = true;
    private HashSet<SongDTO> SelectedSongs = new();
    private Grid<SongDTO> CurrentGrid = new();
    private Modal RemoveSongModal = new();
    private SongDTO CurrentSelectedSong { get; set; } = new();
    private BandDTO CurrentBand { get; set; } = new();

    private async Task<GridDataProviderResult<SongDTO>> SongDataProvider(GridDataProviderRequest<SongDTO> request)
    {
        this.Songs = this.MasterSongList.ToList().AsQueryable();
        if (!this.Songs.Any())
        {
            this.Songs = (await this.SongService.GetSongsByBandIDAsync(this.currentBandID)).AsQueryable();
            this.MasterSongList = this.Songs.ToList();
        }

        if (this.CurrentSongListTypeID > 0)
        {
            this.Songs = this.Songs.Where(s => s.SongListTypeID == this.CurrentSongListTypeID);
        }

        this.IsLoading = false;

        this.StateHasChanged();

        return request.ApplyTo(this.Songs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.MasterSongList = (await this.SongService.GetSongsByBandIDAsync(this.currentBandID)).ToList();
            this.SongListTypes = (await this.SongListTypeService.GetBandIDAsync(this.currentBandID)).ToList();
            this.CurrentSongListTypeID = this.SongListTypes.FirstOrDefault()?.SongListTypeID ?? 0;
            this.CurrentBand = await this.BandService.GetBand(this.currentBandID);
            this.StateHasChanged();
        }
    }

    private async Task OnSongListTypeChanged(int songListTypeID)
    {
        this.CurrentSongListTypeID = songListTypeID;
        await this.RefreshGrid();
    }

    private async Task RefreshGrid()
    {
        await this.CurrentGrid.RefreshDataAsync();
    }

    private async Task OnConfirmRemoveSongClick(SongDTO song)
    {
        this.CurrentSelectedSong = song;
        await this.RemoveSongModal.ShowAsync();
    }

    private async Task OnRemoveSelectedSongClick()
    {
        await this.SongService.DeleteAsync(this.CurrentSelectedSong.SongID);

        this.ClearSelectedSong();
        await this.RemoveSongModal.HideAsync();

        this.ClearSongCache();
        await this.RefreshGrid();
    }

    private async Task OnHideRemoveSongModalClick()
    {
        this.ClearSelectedSong();
        await this.RemoveSongModal.HideAsync();
    }

    private void ClearSelectedSong()
    {
        this.CurrentSelectedSong = new();
    }

    private void ClearSongCache()
    {
        this.Songs = Enumerable.Empty<SongDTO>().AsQueryable();
        this.MasterSongList = Enumerable.Empty<SongDTO>().ToList();
    }

}
