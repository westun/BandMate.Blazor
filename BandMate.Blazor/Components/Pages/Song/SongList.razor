@page "/song/list";
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISongService SongService
@inject ISongListTypeService SongListTypeService
@inject IBandService BandService

@if (this.IsLoading)
{
    <div class="mb-3">
        <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Size="SpinnerSize.ExtraLarge" />
    </div>
}
else
{
    <h1 class="text-center">@this.CurrentBand?.Name</h1>
    
    <div class="mb-3">
        <Button Color="ButtonColor.Primary">Create New Song</Button>
        <Button Color="ButtonColor.Info" @onclick="() => OnSearchMusicCatalogClick()" >
            Search Music Catalog <span class="bi bi-music-note-beamed" aria-hidden="true"></span>
        </Button>
    </div>
    
    <h2>@Songs.Count() Songs</h2>
    <Tabs EnableFadeEffect="false" NavStyle="NavStyle.Pills" Class="mb-3">
        @foreach (var songListType in this.SongListTypes)
        {
            <div @key="songListType.SongListTypeID">
                <Tab Title="@songListType.ListTypeName"
                     IsActive="@(songListType.SongListTypeID == this.CurrentSongListTypeID)"
                     OnClick="() => OnSongListTypeChanged(songListType.SongListTypeID)">
                    <Content></Content>
                </Tab>
            </div>
        }
    </Tabs>
}

@if (this.ShowEditPanel)
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="this.TaskOptionsList">
                <DataAnnotationsValidator />
                <ValidNativeSelect @bind-Value="this.SelectedTaskOption"
                                   Label="Select task:">
                    @foreach (var taskOption in this.TaskOptionsList)
                    {
                        <option value="@taskOption.Value">@taskOption.Text</option>
                    }
                </ValidNativeSelect>
            </EditForm>
        </div>
    </div>

    @if (SelectedTaskOption == (int)TaskOptions.BulkSongRemoval)
    {
        <div class="mb-3">
            <Button Color="ButtonColor.Primary" @onclick="OnOpenBulkSongRemovalModal">Remove Selected Songs</Button>
        </div>
    }

    @if (SelectedTaskOption == (int)TaskOptions.ChangeSongType)
    {
        <div class="mb-3">
            <div>
                (<strong>@this.SelectedSongs.Count</strong>) songs will be moved from <strong>@CurrentSongListType?.ListTypeName</strong>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <EditForm Model="this.SongTypeChangeModel" OnValidSubmit="this.OnChangeSongType">
                        <DataAnnotationsValidator />
                        <ValidNativeSelect @bind-Value="this.SongTypeChangeModel.SongTypeID" Label="Move to:">
                            @foreach (var songType in this.SongListTypes.Where(slt => slt.SongListTypeID != this.CurrentSongListTypeID))
                            {
                                <option value="@songType.SongListTypeID">@songType.ListTypeName</option>
                            }
                        </ValidNativeSelect>
                        <div>
                            <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Change Song Type</Button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@if (!IsLoading)
{
    <div class="row row-cols-lg-auto align-items-center mb-2">
        <div class="col-12">
            <label class="form-label">Search:</label>
        </div>
        <div class="col-12">
            <TextInput @bind-Value="this.SearchForSongCriteria" @oninput="OnSearchForSongs" />
        </div>
        <div class="col-12">
            <Button Color="ButtonColor.Primary" @onclick="ClearSearchResults">Clear</Button>
        </div>
    </div>
}

<Grid @ref="CurrentGrid"
      TItem="SongDTO"
      Class="table table-hover table-bordered table-striped"
      DataProvider="SongDataProvider"
      AllowFiltering="false"
      AllowPaging="false"
      AllowSorting="true"
      Responsive="true"
      AllowSelection="true"
      @bind-SelectedItems="this.SelectedSongs"
      SelectionMode="GridSelectionMode.Multiple"
      AllowDetailView="true">

    <GridColumn TItem="SongDTO" HeaderText="Artist" PropertyName="Artist" SortString="Artist" SortKeySelector="item => item.Artist">
        @context.Artist
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Title" PropertyName="Title" SortString="Title" SortKeySelector="item => item.Title">
        @context.Title
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Created Date" PropertyName="CreatedDataForDisplay" SortString="CreatedDataForDisplay" SortKeySelector="item => item.CreatedDate">
        @context.CreatedDateForDisplay
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Bpm" PropertyName="Bpm" SortString="Bpm" SortKeySelector="item => item.Bpm">
        @context.Bpm
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="KeySignature" PropertyName="KeySignature" SortString="KeySignature" SortKeySelector="item => item.KeySignature">
        @context.KeySignature
    </GridColumn>
    <GridColumn TItem="SongDTO" HeaderText="Actions">
        <Button Color="ButtonColor.Danger"
                Class="ms-2"
                @onclick="() => this.OnConfirmRemoveSongClick(context)" title="Remove Song">
            <Icon Name="IconName.Trash" />
        </Button>
    </GridColumn>
</Grid>

<Modal @ref="RemoveSongModal" Title="Are you sure?" OnHidden="OnHideRemoveSongModalClick">
    <BodyTemplate>
        Are you sure you want to remove the song: <strong>@CurrentSelectedSong?.Title</strong> by <strong>@CurrentSelectedSong?.Artist</strong>?
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideRemoveSongModalClick">Cancel</Button>
        <Button Color="ButtonColor.Danger" @onclick="OnRemoveSelectedSongClick">Remove</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="MusicSearchModal" Title="Search Music Catalog" OnHidden="OnHideMusicSearchModalClick">
    <BodyTemplate>
        <MusicCatalogSearch OnTrackSelected="HandleTrackSelected"></MusicCatalogSearch>
    </BodyTemplate>
</Modal>

<Modal @ref="BulkSongRemovalModal" Title="Are you sure?" OnHidden="OnHideBulkSongRemovalModalClick">
    <BodyTemplate>
        <p>
            Are you sure you want to remove (@this.SelectedSongs.Count) selected songs?
        </p>
        <div>
            <Button Color="ButtonColor.Secondary" @onclick="OnHideBulkSongRemovalModalClick">Cancel</Button>
            <Button Color="ButtonColor.Danger" @onclick="OnRemoveSelectedBulkSongsClick">Remove</Button>
        </div>
        <div class="mt-3">
            <h3>(@this.SelectedSongs.Count()) songs that will be removed:</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Artist</th>
                        <th scope="col">Title</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var song in this.SelectedSongs)
                    {
                        <tr @key="song.SongID">
                            <td>
                                @song.Artist
                            </td>
                            <td>
                                @song.Title
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </BodyTemplate>
</Modal>

<Toasts class="p-3" Messages="ToastMessages" Placement="ToastsPlacement.BottomRight" AutoHide="true" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IEnumerable<SongDTO> Songs { get; set; } = Enumerable.Empty<SongDTO>();
    private List<SongDTO> MasterSongList { get; set; } = Enumerable.Empty<SongDTO>().ToList();

    private List<SongDTO> FilteredSongsBySearch => string.IsNullOrWhiteSpace(this.SearchForSongCriteria)
        ? this.Songs.ToList()
        : this.Songs.Where(s => 
            s.Artist.Contains(this.SearchForSongCriteria, StringComparison.OrdinalIgnoreCase)
            || s.Title.Contains(this.SearchForSongCriteria, StringComparison.OrdinalIgnoreCase)).ToList();

    private string SearchForSongCriteria { get; set; } = string.Empty;

    private int CurrentSongListTypeID { get; set; } = 0;
    private IEnumerable<SongListTypeDTO> SongListTypes { get; set; } = Enumerable.Empty<SongListTypeDTO>();
    private SongListTypeDTO CurrentSongListType => this.SongListTypes?
        .FirstOrDefault(slt => slt.SongListTypeID == this.CurrentSongListTypeID) ?? new();
    private SongTypeModel SongTypeChangeModel { get; set; } = new();

    private int CurrentAccountID { get; set; } = 0;
    private int CurrentBandID { get; set; } = 0;
    private BandDTO CurrentBand { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private HashSet<SongDTO> SelectedSongs = new();

    private Grid<SongDTO> CurrentGrid = new();
    private Modal RemoveSongModal = new();
    private Modal MusicSearchModal = new();
    private Modal BulkSongRemovalModal = new();

    private SongDTO CurrentSelectedSong { get; set; } = new();

    List<ToastMessage> ToastMessages = new List<ToastMessage>();

    private bool ShowEditPanel => this.SelectedSongs.Count > 0;

    private List<TaskOption> TaskOptionsList => this.GetTaskOptionList();
    private int SelectedTaskOption = (int)TaskOptions.Empty;

    private async Task<GridDataProviderResult<SongDTO>> SongDataProvider(GridDataProviderRequest<SongDTO> request)
    {
        this.Songs = this.MasterSongList.ToList();
        if (!this.Songs.Any())
        {
            this.Songs = (await this.SongService.GetSongsByBandIDAsync(this.CurrentBandID));
            this.MasterSongList = this.Songs.ToList();
        }

        if (this.CurrentSongListTypeID > 0)
        {
            this.Songs = this.Songs.Where(s => s.SongListTypeID == this.CurrentSongListTypeID);
        }

        this.Songs = this.FilteredSongsBySearch;

        this.IsLoading = false;

        this.StateHasChanged();

        return request.ApplyTo(this.Songs);
    }

    protected override async Task OnInitializedAsync()
    {
        this.CurrentAccountID = await this.GetCurrentAccountID();

        this.CurrentBand = await this.BandService.GetDefaultBand(this.CurrentAccountID);
        this.CurrentBandID = this.CurrentBand?.BandID ?? 0;

        this.MasterSongList = (await this.SongService.GetSongsByBandIDAsync(this.CurrentBandID)).ToList();
        this.SongListTypes = (await this.SongListTypeService.GetBandIDAsync(this.CurrentBandID)).ToList();
        this.CurrentSongListTypeID = this.SongListTypes.FirstOrDefault()?.SongListTypeID ?? 0;
    }

    private async Task<int> GetCurrentAccountID()
    {
        var authState = await this.AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var accountIDClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountID");
            if (accountIDClaim != null && int.TryParse(accountIDClaim.Value, out int accountID))
            {
                return accountID;
            }
        }
        return 0;
    }

    private async Task OnSongListTypeChanged(int songListTypeID)
    {
        this.CurrentSongListTypeID = songListTypeID;
        this.ClearSelectedTaskOption();
        this.ClearSelectedSongType();
        await this.RefreshGrid();
    }

    private async Task RefreshGrid()
    {
        await this.CurrentGrid.RefreshDataAsync();
    }

    private async Task OnConfirmRemoveSongClick(SongDTO song)
    {
        this.CurrentSelectedSong = song;
        await this.RemoveSongModal.ShowAsync();
    }

    private async Task OnRemoveSelectedSongClick()
    {
        await this.SongService.DeleteAsync(this.CurrentSelectedSong.SongID);

        this.ClearSelectedSong();
        await this.RemoveSongModal.HideAsync();

        this.ClearSongCache();
        await this.RefreshGrid();
    }

    private async Task OnHideRemoveSongModalClick()
    {
        this.ClearSelectedSong();
        await this.RemoveSongModal.HideAsync();
    }

    private void ClearSelectedSong()
    {
        this.CurrentSelectedSong = new();
    }

    private void ClearSongCache()
    {
        this.Songs = Enumerable.Empty<SongDTO>();
        this.MasterSongList = Enumerable.Empty<SongDTO>().ToList();
    }

    private async Task OnHideMusicSearchModalClick()
    {
        await this.MusicSearchModal.HideAsync();
    }

    private async Task OnSearchMusicCatalogClick()
    {
        await this.MusicSearchModal.ShowAsync();
    }  

    private async Task HandleTrackSelected(SongDTO song)
    {
        var newSong = await this.SongService.CreateAsync(new SongDTO
        {
            BandID = this.CurrentBandID,
            CreatedByAccountID = this.CurrentAccountID,
            SongListTypeID = this.CurrentSongListTypeID,
            Artist = song.Artist,
            Title = song.Title,
        });

        var currentSongListTypeName = this.SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == this.CurrentSongListTypeID);
        this.ToastMessages.Add(new ToastMessage
        {
            Type = ToastType.Success,
            Message = $"{newSong.Title} was succesfully added to {currentSongListTypeName?.ListTypeName}.",
        });

        this.ClearSongCache();
        await this.RefreshGrid();
    }

    
    private async Task OnHideBulkSongRemovalModalClick()
    {
        await this.BulkSongRemovalModal.HideAsync();
    }

    private async Task OnRemoveSelectedBulkSongsClick()
    {
        @foreach (var song in this.SelectedSongs)
        {
            await this.SongService.DeleteAsync(song.SongID);
        }

        await this.BulkSongRemovalModal.HideAsync();

        this.ToastMessages.Add(new ToastMessage
        {
            Type = ToastType.Danger,
            Message = $"The selected songs were succesfully removed.",
        });

        this.ClearSelectedTaskOption();

        this.ClearSongCache();
        await this.RefreshGrid();
    }

    private void ClearSelectedTaskOption()
    {
        this.SelectedTaskOption = (int)TaskOptions.Empty;
    }

    private async Task OnOpenBulkSongRemovalModal()
    {
        await this.BulkSongRemovalModal.ShowAsync();
    }

    private async Task OnChangeSongType()
    {
        var songsToChangeType = this.SelectedSongs
            .Select(s => { s.SongListTypeID = this.SongTypeChangeModel.SongTypeID; return s; })
            .ToList();

        foreach (var song in songsToChangeType)
        {
            await this.SongService.UpdateAsync(song);
        }

        var selectedSongType = this.SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == this.SongTypeChangeModel.SongTypeID);
        this.ToastMessages.Add(new ToastMessage
        {
            Type = ToastType.Success,
            Message = $"({songsToChangeType.Count()}) songs were succesfully move to {selectedSongType?.ListTypeName}.",
        });

        this.ClearSelectedTaskOption();
        this.ClearSelectedSongType();
        this.ClearSongCache();
        await this.RefreshGrid();
    }

    private void ClearSelectedSongType()
    {
        this.SongTypeChangeModel.SongTypeID = 0;
    }

    private async Task OnSearchForSongs(ChangeEventArgs e)
    {
        this.SearchForSongCriteria = e.Value?.ToString() ?? string.Empty;
        await this.RefreshGrid();
    }

    private async Task ClearSearchResults()
    {
        this.SearchForSongCriteria = string.Empty;
        await this.RefreshGrid();
    }

    private List<TaskOption> GetTaskOptionList()
    {
        return new List<TaskOption>
        {
            new TaskOption ()
            {
                Text = "Change Song Type",
                Value = (int)TaskOptions.ChangeSongType
            },
            new TaskOption ()
            {
                Text = "Bulk Song Removal",
                Value = (int)TaskOptions.BulkSongRemoval
            },
        };
    }

    private class TaskOption
    {
        public string Text { get; set; }
        public int Value { get; set; }
    }

    private class SongTypeModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Please select a song type.")]
        public int SongTypeID { get; set; } = 0;
    }
}
