@page "/songtype/manage";
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISongListTypeService SongListTypeService
@inject IBandService BandService
@inject ISongService SongService
@inject IUserService UserService

@if (this.IsLoading)
{
    <div class="mb-3">
        <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Size="SpinnerSize.ExtraLarge" />
    </div>
}
else
{
    <h1 class="text-center">Song Types</h1>

    <Alert Color="AlertColor.Info">Drag and drop song types to change the order.</Alert>

    <div class="row">
        <div class="col-md-6">
            <SortableList TItem="SongListTypeDTO"
                          Data="SongListTypes.ToList()"
                          Context="songType"
                          OnUpdate="OnSortableListUpdate">
                <ItemTemplate>
                    <EditForm Model="songType" OnValidSubmit="() => OnCreateSongTypeClick(songType)" FormName="@($"form-{SongListTypes.IndexOf(songType)}")">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-1">
                                @(SongListTypes.IndexOf(songType) + 1))
                            </div>
                            <div class="col-md-4">
                                    <TextInput @bind-Value="@songType.ListTypeName" />
                                    <ValidationMessage For="@(() => songType.ListTypeName)" />
                            </div>
                            <div class="col-md-7">
                                <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Size="ButtonSize.Small">Save</Button>
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => OnSelectSongTypeForRemoval(songType)">Remove</Button>
                                <span class="badge rounded-pill bg-primary ms-3">
                                    @this.GetSongCountBySongTypeID(songType.SongListTypeID) Songs
                                </span>
                            </div>
                        </div>
                    </EditForm>
                </ItemTemplate>
            </SortableList>
        </div>
    </div>
    <div class="mt-3">
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Large" @onclick="() => OnAddNewTypeClick()">Add New Type</Button>
    </div>
}

<Modal @ref="RemoveSongTypeModal" Title="Are you sure?" OnHidden="OnHideRemoveSongTypeModalClick">
    <BodyTemplate>
        <p>Are you sure you want to remove the Song Type <strong>@this.SelectedSongType?.ListTypeName</strong>?</p>

        @if (this.SongsToMove.Any())
        {
            <p>In order to remove a Song Type, all songs that have this type must be assigned a new Song Type.</p>
            <EditForm Model="this.SongTypeMoveToDeletedModel" OnValidSubmit="OnRemoveSongTypeClick">
                <DataAnnotationsValidator />

                <ValidNativeSelect 
                    @bind-Value="this.SongTypeMoveToDeletedModel.SongTypeID" 
                    Label="Select a new song type:">
                    @foreach (var songType in this.SongListTypes.Where(slt => slt.SongListTypeID != this.SelectedSongType.SongListTypeID))
                    {
                        <option value="@songType.SongListTypeID">@songType.ListTypeName</option>
                    }
                </ValidNativeSelect>
                <Button Color="ButtonColor.Secondary" @onclick="OnHideRemoveSongTypeModalClick">Cancel</Button>
                <Button Type="ButtonType.Submit" Color="ButtonColor.Danger">Remove</Button>
            </EditForm>

            <div class="mt-3">
                <h3>(@this.SongsToMove.Count()) songs that will be moved:</h3>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Artist</th>
                            <th scope="col">Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var song in this.SongsToMove)
                        {
                            <tr @key="song.SongID">
                                <td>
                                    @song.Artist
                                </td>
                                <td>
                                    @song.Title
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <Button Color="ButtonColor.Secondary" @onclick="OnHideRemoveSongTypeModalClick">Cancel</Button>
            <Button Color="ButtonColor.Danger" @onclick="OnRemoveSongTypeClick">Remove</Button>
        }
    </BodyTemplate>
</Modal>

<Toasts class="p-3" Messages="ToastMessages" Placement="ToastsPlacement.TopRight" AutoHide="true" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<SongListTypeDTO> SongListTypes { get; set; } = Enumerable.Empty<SongListTypeDTO>().ToList();

    private Modal RemoveSongTypeModal = new();

    private SongListTypeDTO SelectedSongType { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private int CurrentBandID { get; set; }

    List<ToastMessage> ToastMessages = new List<ToastMessage>();

    List<SongDTO> Songs { get; set; } = Enumerable.Empty<SongDTO>().ToList();
    private List<SongDTO> SongsToMove => this.Songs.Where(s => s.SongListTypeID == this.SelectedSongType.SongListTypeID).ToList();

    private SongTypeModel SongTypeMoveToDeletedModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await this.UserService.GetCurrentAccountIDAsync();

        var currentBand = await this.BandService.GetDefaultBand(currentAccountID);
        this.CurrentBandID = currentBand?.BandID ?? 0;

        this.SongListTypes = (await this.SongListTypeService.GetBandIDAsync(this.CurrentBandID)).ToList();

        this.Songs = (await this.SongService.GetSongsByBandIDAsync(this.CurrentBandID)).ToList();

        this.IsLoading = false;
    }

    private async Task OnSortableListUpdate(SortableListEventArgs args)
    {
        //this needs some work
        if (string.IsNullOrWhiteSpace(this.SongListTypes.LastOrDefault().ListTypeName))
        {
            //do not allow stub items to be moved
            return;
        }

        var itemToMove = this.SongListTypes[args.OldIndex];

        this.SongListTypes.RemoveAt(args.OldIndex);

        if (args.NewIndex < this.SongListTypes.Count)
            this.SongListTypes.Insert(args.NewIndex, itemToMove);
        else
            this.SongListTypes.Add(itemToMove);

        this.UpdateSongTypesSortOrder();

        foreach (var songType in this.SongListTypes)
        {
            await this.SaveSongType(songType);
        }
    }

    private async Task OnHideRemoveSongTypeModalClick()
    {
        this.ClearSelectedSongType();
        this.ClearSongTypeToMoveToSelection();
        await this.RemoveSongTypeModal.HideAsync();
    }

    private async Task OnSelectSongTypeForRemoval(SongListTypeDTO songTypeDTO)
    {
        this.SelectedSongType = songTypeDTO;
        await this.RemoveSongTypeModal.ShowAsync();
    }

    private async Task OnRemoveSongTypeClick()
    {
        var songsToMoveWithUpdateSongTypeId = this.Songs
            .Where(s => s.SongListTypeID == this.SelectedSongType.SongListTypeID)
            .Select(s => { s.SongListTypeID = this.SongTypeMoveToDeletedModel.SongTypeID; return s; })
            .ToList();

        foreach (var song in songsToMoveWithUpdateSongTypeId)
        {
            await this.SongService.UpdateAsync(song);
        }

        if (songsToMoveWithUpdateSongTypeId.Any())
        {
            this.ToastMessages.Add(new ToastMessage
            {
                Type = ToastType.Success,
                Message = $"{songsToMoveWithUpdateSongTypeId.Count()} Songs were succesfully moved to their new song type.",
            });
        }

        await this.SongListTypeService.DeleteAsync(this.SelectedSongType.SongListTypeID);

        var indexToRemove = this.SongListTypes.IndexOf(this.SelectedSongType);
        this.SongListTypes.RemoveAt(indexToRemove);

        await this.RemoveSongTypeModal.HideAsync();

        this.ToastMessages.Add(new ToastMessage
        {
            Type = ToastType.Danger,
            Message = $"{this.SelectedSongType.ListTypeName} was removed.",
        });

        this.UpdateSongTypesSortOrder();

        this.ClearSelectedSongType();
        this.ClearSongTypeToMoveToSelection();
    }

    private void UpdateSongTypesSortOrder()
    {
        for (int i = 0; i < this.SongListTypes.Count; i++)
        {
            var songType = this.SongListTypes[i];
            songType.SortOrder = i + 1;
        }
    }

    private void ClearSelectedSongType()
    {
        this.SelectedSongType = new();
    }

    private async Task OnAddNewTypeClick()
    {
        this.SongListTypes.Add(new SongListTypeDTO());
    }

    private async Task OnCreateSongTypeClick(SongListTypeDTO songTypeDTO)
    {
        await this.SaveSongType(songTypeDTO);

        this.ToastMessages.Add(new ToastMessage
        {
            Type = ToastType.Success,
            Message = $"{songTypeDTO.ListTypeName} was succesfully saved.",
        });
    }

    private async Task SaveSongType(SongListTypeDTO songTypeDTO)
    {
        songTypeDTO.BandID = this.CurrentBandID;
        songTypeDTO.SortOrder = this.SongListTypes.IndexOf(songTypeDTO) + 1;

        if (songTypeDTO.SongListTypeID > 0)
        {
            var songTypeFromDB = await this.SongListTypeService.UpdateAsync(songTypeDTO);
        }
        else
        {
            var songTypeDTOWithID = await this.SongListTypeService.CreateAsync(songTypeDTO);
            var index = this.SongListTypes.IndexOf(songTypeDTO);
            var songToUpdate = this.SongListTypes[index];
            songToUpdate.SongListTypeID = songTypeDTOWithID.SongListTypeID;
        }
    }

    private void ClearSongTypeToMoveToSelection()
    {
        this.SongTypeMoveToDeletedModel = new();
    }

    private int GetSongCountBySongTypeID(int songTypeID)
    {
        return this.Songs.Count(s => s.SongListTypeID == songTypeID);
    }

    private class SongTypeModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Please select a song type.")]
        public int SongTypeID { get; set; } = 0;
    }
}
