@page "/song/edit/{SongID:int}";
@using AutoMapper
@using BandMate.Blazor.Components.Pages.SongEdit.Components
@using BandMate.Domain.Core.Models
@attribute [Authorize]
@rendermode InteractiveServer
@inject IBandService BandService
@inject IGenericDalService<Song, SongDTO> GenericDalService
@inject IMapper Mapper
@inject ISongService SongService
@inject ISongListTypeService SongListTypeService
@inject IUserService UserService
@inject NavigationManager NavigationManager

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="Edit Song Details"/>

    <SongEditNav SongID="SongDTO.SongID" />

    @if (ShowSuccessAlert)
    {
        <Alert Color="AlertColor.Success" Dismissable="false" Class="mt-3">
            <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon>
            Song updated successfully.
        </Alert>
    }

    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Song Details</h3>
            </div>
            <div class="card-body">
                <EditForm Model="@SongModel" OnValidSubmit="HandleSubmit" FormName="SongEntryForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <ValidNativeSelect @bind-Value="SongModel.SongListTypeID" Label="Song Type">
                                    @foreach (var type in SongTypes)
                                    {
                                        <option value="@type.SongListTypeID">@type.ListTypeName</option>
                                    }
                                </ValidNativeSelect>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Artist</label>
                            <InputText @bind-Value="SongModel.Artist" disabled="@DisableFields" class="form-control" placeholder="Artist Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Title</label>
                            <InputText @bind-Value="SongModel.Title" disabled="@DisableFields" class="form-control" placeholder="Song Title" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">BPM</label>
                            <InputNumber @bind-Value="SongModel.Bpm" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Key Signature</label>
                            <InputText @bind-Value="SongModel.KeySignature" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">YouTube URL</label>
                            <InputText @bind-Value="SongModel.YoutubeURL" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sheet Music URL</label>
                            <InputText @bind-Value="SongModel.SheetMusicURL" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Lyric URL</label>
                            <InputText @bind-Value="SongModel.LyricURL" class="form-control" />
                        </div>

                        <div class="col-6">
                            <label class="form-label">Band Notes</label>
                            <InputText @bind-Value="SongModel.Notes" class="form-control" />
                        </div>

                        @* <div class="col-md-4">
                            <label class="form-label">MP3 File Name</label>
                            <InputText @bind-Value="Song.Mp3FileName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tab File Name</label>
                            <InputText @bind-Value="Song.TabFileName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Lyric File Name</label>
                            <InputText @bind-Value="Song.LyricFileName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Sheet Music File Name</label>
                            <InputText @bind-Value="Song.SheetMusicFileName" class="form-control" />
                        </div> *@
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success px-4">Save Song</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int SongID { get; set; }

    private EditSongModel SongModel { get; set; }
    private SongDTO SongDTO { get; set; }
    private BandDTO CurrentBand { get; set; } = new();
    private int CurrentBandID { get; set; } = 0;
    private int CurrentAccountID { get; set; } = 0;

    private bool IsLoading { get; set; } = true;
    private bool ShowSuccessAlert { get; set; }
    private bool DisableFields { get; set; }

    private SongTypeModel SongTypeModel { get; set; } = new();
    private IEnumerable<SongListTypeDTO> SongTypes { get; set; } = new List<SongListTypeDTO>();

    protected override async Task OnInitializedAsync()
    {
        CurrentAccountID = await UserService.GetCurrentAccountIDAsync();

        CurrentBand = await BandService.GetDefaultBand(CurrentAccountID);
        CurrentBandID = CurrentBand?.BandID ?? 0;

        //these are all the songs the user has access to with the current band they are viewing
        var songs = (await SongService.GetSongsByBandIDAsync(CurrentBandID)).ToList();

        SongDTO = songs.FirstOrDefault(s => s.SongID == SongID);
        if (SongDTO is null)
        {
            //not authorized to view this song
            NavigationManager.NavigateTo("/");
        }

        SongModel = Mapper.Map(SongDTO, SongModel);

        SongTypes = (await this.SongListTypeService.GetBandIDAsync(this.CurrentBandID)).ToList();

        if (!string.IsNullOrEmpty(SongDTO?.ExternalAlbumID))
        {
            //don't allow artist and title to be changed when song comes from an external source (like spotify)
            DisableFields = true;
        }

        IsLoading = false;
    }

    private async Task HandleSubmit()
    {
        SongDTO = Mapper.Map(SongModel, SongDTO);
        await SongService.UpdateAsync(SongDTO);

        ShowSuccessAlert = true;
        StateHasChanged();

        await Task.Delay(5000);  //give the alert x number of seconds before it dissapears.  This won't block the ui thread

        ShowSuccessAlert = false;
        StateHasChanged();
    }
}