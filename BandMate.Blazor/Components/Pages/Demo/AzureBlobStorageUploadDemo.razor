@page "/upload"
@rendermode InteractiveServer
@inject IBandResourceManager BandResourceManager
@inject IUserService UserService
@inject IBandService BandService

<div class="card shadow-sm p-4 border-light-subtle bg-white">
    <h5 class="fw-bold mb-3 text-dark">Upload to Azure Storage</h5>
    
    <div class="mb-3">
        <label class="form-label small fw-bold">Select File</label>
        <InputFile OnChange="HandleFileSelected" class="form-control border-light-subtle shadow-sm" />
    </div>

    @if (isUploading)
    {
        <div class="text-primary fw-medium small mb-2">
            <i class="bi bi-arrow-repeat spin me-1"></i> Uploading...
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusMessage.Contains("successfully") ? "alert-success" : "alert-danger") py-2 small mt-2">
            @statusMessage
        </div>
    }
</div>

@code {
    private string statusMessage { get; set; } = string.Empty;
    private bool isUploading { get; set; }
    private const long maxFileSize = 1024 * 1024 * 10; // 10MB limit
    private int CurrentBandID { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        var currentAccountID = await UserService.GetCurrentAccountIDAsync();
        var currentBand = await BandService.GetDefaultBand(currentAccountID);
        CurrentBandID = currentBand?.BandID ?? 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        statusMessage = string.Empty;

        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxFileSize);
            await BandResourceManager.UploadResourceAsync(
                bandId: CurrentBandID,
                fileName: file.Name,
                content: stream,
                contentType: file.ContentType
            );

            statusMessage = $"File '{file.Name}' uploaded successfully!";
        }
        catch (Exception ex)
        {
            statusMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }
}
