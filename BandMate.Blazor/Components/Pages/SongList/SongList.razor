@page "/song/list";
@using BandMate.Blazor.Components.Pages.SongList.Components
@attribute [Authorize]
@rendermode InteractiveServer
@inject IBandResourceManager BandResourceManager
@inject IBandService BandService
@inject IFileUploadValidator FileValidator
@inject ISongListTypeService SongListTypeService
@inject ISongService SongService
@inject IUserService UserService

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="@CurrentBand?.Name" />

    <SongListActions OnCreate="OnCreateNewSongClick"
                     OnSearchCatalog="OnSearchMusicCatalogClick" />
        
    @if (ShowCreateSongPanel)
    {
        <div class="row">
            <div class="col-md-8">
                <SongCreateForm Model="NewCreateSongModel"
                                OnSave="OnCreateSong"
                                OnCancel="OnCancelCreatingNewSong" />
            </div>
        </div>
    }

    <h2>@Songs.Count() Songs</h2>
    <SongListTabs Types="SongListTypes"
                  ActiveId="CurrentSongListTypeID"
                  OnChanged="OnSongListTypeChanged" />
    
    <SongBulkActions SelectedSongs="SelectedSongs"
                     AvailableTypes="SongListTypes"
                     CurrentTypeId="CurrentSongListTypeID"
                     OnBulkRemoveClick="OnOpenBulkSongRemovalModal"
                     OnMoveSongs="OnChangeSongType"
                     @bind-SelectedTask="SelectedTask" />

    <SongSearchBar @bind-Criteria="SearchForSongCriteria"
                   OnSearchTriggered="RefreshGrid" />

    <Grid @ref="CurrentGrid"
          TItem="SongListGridItemModel"
          Class="table table-hover table-bordered table-striped"
          DataProvider="SongDataProvider"
          AllowFiltering="false"
          AllowPaging="false"
          AllowSorting="true"
          Responsive="true"
          AllowSelection="true"
          @bind-SelectedItems="SelectedSongs"
          SelectionMode="GridSelectionMode.Multiple"
          AllowDetailView="true">
    
        <GridColumns>
            <GridColumn TItem="SongListGridItemModel" HeaderText="Artist" PropertyName="Artist" SortString="Artist" SortKeySelector="item => item.Song.Artist" StringComparison="StringComparison.OrdinalIgnoreCase">
                @context.Song.Artist
            </GridColumn>
            <GridColumn TItem="SongListGridItemModel" HeaderText="Title" PropertyName="Title" SortString="Title" SortKeySelector="item => item.Song.Title" StringComparison="StringComparison.OrdinalIgnoreCase">
                @context.Song.Title
            </GridColumn>
            <GridColumn TItem="SongListGridItemModel" HeaderText="Created Date" PropertyName="CreatedDataForDisplay" SortString="CreatedDataForDisplay" SortKeySelector="item => item.Song.CreatedDate">
                @context.Song.CreatedDateForDisplay
            </GridColumn>
            <GridColumn TItem="SongListGridItemModel" HeaderText="Bpm" PropertyName="Bpm" SortString="Bpm" SortKeySelector="item => item.Song.Bpm">
                @context.Song.Bpm
            </GridColumn>
            <GridColumn TItem="SongListGridItemModel" HeaderText="KeySignature" PropertyName="KeySignature" SortString="KeySignature" SortKeySelector="item => item.Song.KeySignature">
                @context.Song.KeySignature
            </GridColumn>
            <GridColumn TItem="SongListGridItemModel" HeaderText="Actions">
                <a class="btn btn-secondary" href="song/details/@context.Song.SongID">
                    <span class="bi bi-info-circle"></span> 
                    View Details
                </a>
                <a class="btn btn-secondary" href="song/edit/@context.Song.SongID">
                    <span class="bi bi-pencil-fill"></span>
                    Edit
                </a>
                <Button Color="ButtonColor.Danger"
                        Class="ms-2"
                        @onclick="() => OnConfirmRemoveSongClick(context)" title="Remove Song">
                    <Icon Name="IconName.Trash" />
                </Button>
            </GridColumn>
        </GridColumns>

        <GridDetailView TItem="SongListGridItemModel">
            <SongDetailView OnSongFileChange="HandleFileSelected"
                            SongItem="@context" />
        </GridDetailView>
    </Grid>
}

<RemoveSongModal @ref="RemoveSongModal"
                 SongModel="CurrentSelectedSong"
                 OnCancel="OnHideRemoveSongModalClick"
                 OnConfirm="OnRemoveSelectedSongClick" />

<Modal @ref="MusicSearchModal" Title="Search Music Catalog" OnHidden="OnHideMusicSearchModalClick">
    <BodyTemplate>
        <MusicCatalogSearch OnTrackSelected="HandleTrackSelected"></MusicCatalogSearch>
    </BodyTemplate>
</Modal>

<BulkSongRemovalModal @ref="BulkSongRemovalModal"
                     Songs="SelectedSongs"
                     OnConfirm="OnRemoveSelectedBulkSongsClick"
                     OnCancel="OnHideBulkSongRemovalModalClick" />

<Toasts class="p-3" Messages="ToastMessages" Placement="ToastsPlacement.BottomRight" AutoHide="true" />

@if (IsUploading)
{
    <FileUploadProgressBar @ref="FileUploadProgressBar" ProgressValue="@UploadPercentageDisplay" />
}

@code {
    // --- 1. Parameters & Cascading Values ---

    // === 2. Core Data & Collections ===
    private BandDTO CurrentBand { get; set; } = new();
    private int CurrentBandID { get; set; } = 0;
    private int CurrentAccountID { get; set; } = 0;

    private List<SongListGridItemModel> MasterSongList { get; set; } = Enumerable.Empty<SongListGridItemModel>().ToList();
    private IEnumerable<SongListGridItemModel> Songs { get; set; } = Enumerable.Empty<SongListGridItemModel>();
    private IEnumerable<SongListTypeDTO> SongListTypes { get; set; } = Enumerable.Empty<SongListTypeDTO>();
    private int CurrentSongListTypeID { get; set; } = 0;

    // === 3. Search & Selection State ===
    private string SearchForSongCriteria { get; set; } = string.Empty;
    private HashSet<SongListGridItemModel> SelectedSongs { get; set; } = new();
    private TaskOptions SelectedTask { get; set; } = TaskOptions.Empty;

    // For single-item actions (like deleting one song)
    private SongListGridItemModel CurrentSelectedSong { get; set; } = new();

    // === 4. UI Toggles & Feedback ===
    private bool IsLoading { get; set; } = true;
    private bool ShowCreateSongPanel { get; set; } = false;
    private List<ToastMessage> ToastMessages { get; set; } = new();

    // === 5. New Component Models ===
    // This feeds your SongCreateForm component
    private CreateSongModel NewCreateSongModel { get; set; } = new();

    // === 6. Component References (BlazorBootstrap / Library) ===
    private Grid<SongListGridItemModel> CurrentGrid = new();
    private RemoveSongModal RemoveSongModal = default!;
    private Modal MusicSearchModal = new();
    private BulkSongRemovalModal BulkSongRemovalModal = new();

    // File upload 
    private FileUploadProgressBar FileUploadProgressBar { get; set; }
    private bool IsUploading { get; set; }
    private string UploadPercentageDisplay { get; set; } = "0%";

    private async Task<GridDataProviderResult<SongListGridItemModel>> SongDataProvider(GridDataProviderRequest<SongListGridItemModel> request)
    {
        Songs = MasterSongList.ToList();
        if (!Songs.Any())
        {
            var songs = (await SongService.GetSongsByBandIDAsync(CurrentBandID));
            Songs = songs.Select(s => new SongListGridItemModel { Song = s });
            MasterSongList = Songs.ToList();
        }

        if (CurrentSongListTypeID > 0)
        {
            Songs = Songs.Where(s => s.Song.SongListTypeID == CurrentSongListTypeID);
        }

        @if (!string.IsNullOrWhiteSpace(SearchForSongCriteria))
        {
            Songs = Songs.Where(s =>
                s.Song.Artist.Contains(SearchForSongCriteria, StringComparison.OrdinalIgnoreCase) ||
                s.Song.Title.Contains(SearchForSongCriteria, StringComparison.OrdinalIgnoreCase));
        }

        IsLoading = false;

        StateHasChanged();

        return request.ApplyTo(Songs);
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentAccountID = await UserService.GetCurrentAccountIDAsync();

        CurrentBand = await BandService.GetDefaultBand(CurrentAccountID);
        CurrentBandID = CurrentBand?.BandID ?? 0;

        var songs = (await SongService.GetSongsByBandIDAsync(CurrentBandID)).ToList();
        MasterSongList = songs.Select(s => new SongListGridItemModel { Song = s }).ToList();
        SongListTypes = (await SongListTypeService.GetBandIDAsync(CurrentBandID)).ToList();
        CurrentSongListTypeID = SongListTypes.FirstOrDefault()?.SongListTypeID ?? 0;

        IsLoading = false;
    }

    // === 2. Navigation & Grid State ===
    private async Task OnSongListTypeChanged(int songListTypeID)
    {
        CurrentSongListTypeID = songListTypeID;
        ClearSelectedTaskOption();
        await RefreshGrid();
    }

    private async Task RefreshGrid()
    {
        await CurrentGrid.RefreshDataAsync();
    }

    // === 3. Song Creation (Manual & Catalog) ===
    private void OnCreateNewSongClick() => ShowCreateSongPanel = true;

    private async Task OnCreateSong()
    {
        var newSong = await SongService.CreateAsync(new SongDTO
        {
            BandID = CurrentBandID,
            CreatedByAccountID = CurrentAccountID,
            SongListTypeID = CurrentSongListTypeID,
            Artist = NewCreateSongModel.Artist,
            Title = NewCreateSongModel.Title
        });

        newSong.CreatedDateForDisplay = DateTime.Now.ToString("d");

        var newSongModel = new SongListGridItemModel { Song = newSong };

        MasterSongList.Add(newSongModel);
        SortMasterList();

        ShowToast(ToastType.Success, $"New song {newSong.Title} by {newSong.Artist} was created succesfully.");
        ClearNewSongRequest();
        await RefreshGrid();
    }

    private async Task HandleTrackSelected(SongDTO song)
    {
        var newSong = await SongService.CreateAsync(new SongDTO
        {
            BandID = CurrentBandID,
            CreatedByAccountID = CurrentAccountID,
            SongListTypeID = CurrentSongListTypeID,
            Artist = song.Artist,
            Title = song.Title,
            ExternalAlbumID = song.ExternalAlbumID,
        });

        newSong.CreatedDateForDisplay = DateTime.Now.ToString("d");

        var newSongModel = new SongListGridItemModel { Song = newSong };

        MasterSongList.Add(newSongModel);
        SortMasterList();

        var currentSongListTypeName = SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == CurrentSongListTypeID);
        ShowToast(ToastType.Success, $"{song.Title} was succesfully added to {currentSongListTypeName?.ListTypeName}.");

        await RefreshGrid();
    }

    private void OnCancelCreatingNewSong() => ClearNewSongRequest();

    private void ClearNewSongRequest()
    {
        NewCreateSongModel = new();
        ShowCreateSongPanel = false;
    }

    // === 4. Search & Filtering ===
    private async Task OnSearchForSongs(ChangeEventArgs e)
    {
        SearchForSongCriteria = e.Value?.ToString() ?? string.Empty;
        await RefreshGrid();
    }

    private async Task ClearSearchResults()
    {
        SearchForSongCriteria = string.Empty;
        await RefreshGrid();
    }

    private void SortMasterList()
    {
        MasterSongList = MasterSongList
            .OrderBy(s => s.Song.Artist, StringComparer.OrdinalIgnoreCase)
            .ThenBy(s => s.Song.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    // === 5. Bulk Actions (Move & Remove) ===
    private void ClearSelectedTaskOption() => SelectedTask = TaskOptions.Empty;

    private async Task OnChangeSongType(int targetTypeID)
    {
        //this will assign new ListTypeID (targetTypeID) to each song in SelectedSongs
        var createSongTasks = SelectedSongs.Select(s =>
        {
            s.Song.SongListTypeID = targetTypeID;
            return SongService.UpdateAsync(s.Song);
        });
        await Task.WhenAll(createSongTasks);

        var selectedSongType = SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == targetTypeID);
        ShowToast(ToastType.Success, $"({createSongTasks.Count()}) songs were succesfully moved to {selectedSongType?.ListTypeName}.");
        ClearSelectedTaskOption();
        await RefreshGrid();
    }

    private async Task OnRemoveSelectedBulkSongsClick()
    {
        var tasks = SelectedSongs.Select(s => SongService.DeleteAsync(s.Song.SongID));
        await Task.WhenAll(tasks);

        foreach (var song in SelectedSongs)
        {
            MasterSongList.Remove(song);
        }

        await BulkSongRemovalModal.HideAsync();
        ShowToast(ToastType.Danger, "The selected songs were succesfully removed.");
        ClearSelectedTaskOption();
        await RefreshGrid();
    }

    // === 6. Single Item Actions & Modals ===
    private async Task OnConfirmRemoveSongClick(SongListGridItemModel song)
    {
        CurrentSelectedSong = song;
        await RemoveSongModal.ShowAsync();
    }

    private async Task OnRemoveSelectedSongClick()
    {
        await SongService.DeleteAsync(CurrentSelectedSong.Song.SongID);
        await RemoveSongModal.HideAsync();

        MasterSongList.Remove(CurrentSelectedSong);

        CurrentSelectedSong = new();

        await RefreshGrid();
    }

    private async Task OnOpenBulkSongRemovalModal() => await BulkSongRemovalModal.ShowAsync();
    private async Task OnHideBulkSongRemovalModalClick() => await BulkSongRemovalModal.HideAsync();
    private async Task OnSearchMusicCatalogClick() => await MusicSearchModal.ShowAsync();
    private async Task OnHideMusicSearchModalClick() => await MusicSearchModal.HideAsync();
    private async Task OnHideRemoveSongModalClick() => CurrentSelectedSong = new();

    // ==== File Upload === 
    private async Task HandleFileSelected(SongEvents.SongFileChangedEventArgs args)
    {
        IsUploading = true;
        StateHasChanged();
        await Task.Delay(1000); //hack: try to avoid the flicker effect for small files when it opens and closes too fast

        var songModel = args.SongModel;
        var fileUploadType = args.FileUploadType;

        songModel.UploadErrorMessage = string.Empty;
        songModel.UploadSuccessMessage = string.Empty;

        try
        {
            var file = args.FileArgs.File;
            if (!FileValidator.IsExtensionAllowed(file.Name))
            {
                songModel.UploadErrorMessage = "Invalid file type";
                return;
            }

            var progressHandler = new Progress<long>(async progress =>
            {
                double percentage = (double)progress / file.Size * 100;

                // Use InvokeAsync to ensure the UI thread handles the update
                await InvokeAsync(async () =>
                {
                    FileUploadProgressBar.SetWidth(percentage);
                    FileUploadProgressBar.SetLabel($"{(int)percentage}%");
                    UploadPercentageDisplay = $"{(int)percentage}%";
                    StateHasChanged();
                    await Task.Yield();
                });
            });

            var maxFileSize = 1024 * 1024 * 30; // 10MB limit
            using var stream = file.OpenReadStream(maxFileSize);

            var uploadResult = await BandResourceManager.UploadResourceAsync(
                bandId: CurrentBandID,
                fileName: file.Name,
                content: stream,
                contentType: file.ContentType,
                progressHandler: progressHandler
            );

            StateHasChanged();

            if (uploadResult.Errors?.Any() ?? false)
            {
                songModel.UploadErrorMessage = string.Join(" | ", uploadResult.Errors);
                return;
            }

            await Task.Delay(1000); //hack: try to allow progress bar to always display that it's at 100% when it's done

            //use latest version from db so fields are not overidden
            var songFromDB = await SongService.GetByIdAsync(songModel.Song.SongID);
            AssignFileNamesForSong(songFromDB, fileUploadType, uploadResult.Url, sasUrl: null);

            await SongService.UpdateAsync(songFromDB);

            var sasUrl = await BandResourceManager.GetSasUrlAsync(CurrentBandID, file.Name);
            AssignFileNamesForSong(songModel.Song, fileUploadType, uploadResult.Url, sasUrl);

            songModel.UploadSuccessMessage = $"File '{file.Name}' was uploaded successfully!";
        }
        catch (Exception ex)
        {
            songModel.UploadErrorMessage = "An unexpected error occurred.  Please try again.";
        }
        finally
        {
            ResetProgressBar();
            StateHasChanged();
        }
    }

    private void ResetProgressBar()
    {
        IsUploading = false;
        UploadPercentageDisplay = "0%";
    }

    private void AssignFileNamesForSong(SongDTO song, FileUploadType fileUploadType, string blobFullUrl, string sasUrl)
    {
        switch (fileUploadType)
        {
            case FileUploadType.Tab:
                song.TabFileName = blobFullUrl;
                song.TabFileNameSasUrl = sasUrl ?? song.TabFileNameSasUrl;
                break;
            case FileUploadType.Lyric:
                song.LyricFileName = blobFullUrl;
                song.LyricFileNameSasUrl = sasUrl ?? song.LyricFileNameSasUrl;
                break;
            case FileUploadType.MP3:
                song.Mp3FileName = blobFullUrl;
                song.Mp3FileNameSasUrl = sasUrl ?? song.Mp3FileNameSasUrl;
                break;
            case FileUploadType.SheetMusic:
                song.SheetMusicFileName = blobFullUrl;
                song.SheetMusicFileNameSasUrl = sasUrl ?? song.SheetMusicFileNameSasUrl;
                break;
        }
    }

    // === 7. Helpers ===
    private void ShowToast(ToastType type, string message)
    {
        ToastMessages.Add(new ToastMessage { Type = type, Message = message });
    }
}
