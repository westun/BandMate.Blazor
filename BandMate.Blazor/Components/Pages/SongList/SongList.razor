@page "/song/list";
@using BandMate.Blazor.Components.Pages.SongList.Components
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISongService SongService
@inject ISongListTypeService SongListTypeService
@inject IBandService BandService
@inject IUserService UserService
@inject IBandResourceManager BandResourceManager
@inject IFileUploadValidator FileValidator

@if (this.IsLoading)
{
    <LoadingSpinner />
}
else
{
    <PageHeader Title="@this.CurrentBand?.Name" />

    <SongListActions OnCreate="OnCreateNewSongClick"
                     OnSearchCatalog="OnSearchMusicCatalogClick" />
        
    @if (this.ShowCreateSongPanel)
    {
        <div class="row">
            <div class="col-md-8">
                <SongCreateForm Model="this.NewCreateSongModel"
                                OnSave="OnCreateSong"
                                OnCancel="OnCancelCreatingNewSong" />
            </div>
        </div>
    }

    <h2>@Songs.Count() Songs</h2>
    <SongListTabs Types="SongListTypes"
                  ActiveId="CurrentSongListTypeID"
                  OnChanged="OnSongListTypeChanged" />
    
    <SongBulkActions SelectedSongs="this.SelectedSongs"
                     AvailableTypes="this.SongListTypes"
                     CurrentTypeId="this.CurrentSongListTypeID"
                     OnBulkRemoveClick="OnOpenBulkSongRemovalModal"
                     OnMoveSongs="OnChangeSongType"
                     @bind-SelectedTask="SelectedTask" />

    <SongSearchBar @bind-Criteria="SearchForSongCriteria"
                   OnSearchTriggered="RefreshGrid" />
}

<Grid @ref="CurrentGrid"
      TItem="SongDTO"
      Class="table table-hover table-bordered table-striped"
      DataProvider="SongDataProvider"
      AllowFiltering="false"
      AllowPaging="false"
      AllowSorting="true"
      Responsive="true"
      AllowSelection="true"
      @bind-SelectedItems="this.SelectedSongs"
      SelectionMode="GridSelectionMode.Multiple"
      AllowDetailView="true">
    
    <GridColumns>
        <GridColumn TItem="SongDTO" HeaderText="Artist" PropertyName="Artist" SortString="Artist" SortKeySelector="item => item.Artist" StringComparison="StringComparison.OrdinalIgnoreCase">
            @context.Artist
        </GridColumn>
        <GridColumn TItem="SongDTO" HeaderText="Title" PropertyName="Title" SortString="Title" SortKeySelector="item => item.Title" StringComparison="StringComparison.OrdinalIgnoreCase">
            @context.Title
        </GridColumn>
        <GridColumn TItem="SongDTO" HeaderText="Created Date" PropertyName="CreatedDataForDisplay" SortString="CreatedDataForDisplay" SortKeySelector="item => item.CreatedDate">
            @context.CreatedDateForDisplay
        </GridColumn>
        <GridColumn TItem="SongDTO" HeaderText="Bpm" PropertyName="Bpm" SortString="Bpm" SortKeySelector="item => item.Bpm">
            @context.Bpm
        </GridColumn>
        <GridColumn TItem="SongDTO" HeaderText="KeySignature" PropertyName="KeySignature" SortString="KeySignature" SortKeySelector="item => item.KeySignature">
            @context.KeySignature
        </GridColumn>
        <GridColumn TItem="SongDTO" HeaderText="Actions">
            <Button Color="ButtonColor.Danger"
                    Class="ms-2"
                    @onclick="() => this.OnConfirmRemoveSongClick(context)" title="Remove Song">
                <Icon Name="IconName.Trash" />
            </Button>
        </GridColumn>
    </GridColumns>
    <GridDetailView TItem="SongDTO">
        <div class="p-3 border-top bg-light">
            <h5 class="mb-2">Song Details for @context.Title</h5>
            @if (UploadErrorMessages.Any())
            {
                <div class="alert alert-danger mt-3 shadow-sm" role="alert">
                    <div class="d-flex align-items-center mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Upload Failed</strong>
                    </div>
                    <ul class="mb-0 ps-3">
                        @foreach (var error in UploadErrorMessages)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            else if (!string.IsNullOrEmpty(UploadSuccessMessage))
            {
                <div class="alert alert-success mt-3 shadow-sm border-0" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Upload Successful!</strong>
                            <div class="small">
                                @UploadSuccessMessage
                            </div>
                        </div>
                        <button type="button" class="btn-close ms-auto"
                                @onclick="() => UploadSuccessMessage = string.Empty"
                                aria-label="Close">
                        </button>
                    </div>
                </div>
            }
            <div class="mb-3">
                @if (string.IsNullOrEmpty(context.TabFileName))
                {
                    <div class="upload-container mb-5 ">        
                        <label for="file-upload" class="drop-zone w-100">
                            <div class="text-center p-5">
                                <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>
                                <h4 class="mt-3">Drag & Drop Files Here</h4>
                                <p class="text-muted">Or click to browse from your computer</p>
                                <InputFile id="file-upload" OnChange="@(e => HandleFileSelected(e, context, FileUploadType.Tab))" class="d-none" multiple />
                            </div>
                        </label>
                    </div>

                    @* <label class="form-label small fw-bold">Select File</label>
                    <InputFile OnChange="@(e => HandleFileSelected(e, context, FileUploadType.Tab))" class="form-control border-light-subtle shadow-sm" /> *@
                }
                else
                {
                    <a class="btn btn-link" href="@context.TabFileName" target="_blank">Download Tablature</a>
                }
            </div>
        </div>
    </GridDetailView>
</Grid>

<RemoveSongModal @ref="RemoveSongModal"
                 Song="this.CurrentSelectedSong"
                 OnCancel="OnHideRemoveSongModalClick"
                 OnConfirm="OnRemoveSelectedSongClick" />

<Modal @ref="MusicSearchModal" Title="Search Music Catalog" OnHidden="OnHideMusicSearchModalClick">
    <BodyTemplate>
        <MusicCatalogSearch OnTrackSelected="HandleTrackSelected"></MusicCatalogSearch>
    </BodyTemplate>
</Modal>

<BulkSongRemovalModal @ref="BulkSongRemovalModal"
                     Songs="SelectedSongs"
                     OnConfirm="OnRemoveSelectedBulkSongsClick"
                     OnCancel="OnHideBulkSongRemovalModalClick" />

<Toasts class="p-3" Messages="ToastMessages" Placement="ToastsPlacement.BottomRight" AutoHide="true" />

@code {
    // --- 1. Parameters & Cascading Values ---

    // === 2. Core Data & Collections ===
    private BandDTO CurrentBand { get; set; } = new();
    private int CurrentBandID { get; set; } = 0;
    private int CurrentAccountID { get; set; } = 0;

    private List<SongDTO> MasterSongList { get; set; } = Enumerable.Empty<SongDTO>().ToList();
    private IEnumerable<SongDTO> Songs { get; set; } = Enumerable.Empty<SongDTO>();
    private IEnumerable<SongListTypeDTO> SongListTypes { get; set; } = Enumerable.Empty<SongListTypeDTO>();
    private int CurrentSongListTypeID { get; set; } = 0;

    // === 3. Search & Selection State ===
    private string SearchForSongCriteria { get; set; } = string.Empty;
    private HashSet<SongDTO> SelectedSongs { get; set; } = new();
    private TaskOptions SelectedTask { get; set; } = TaskOptions.Empty;

    // For single-item actions (like deleting one song)
    private SongDTO CurrentSelectedSong { get; set; } = new();

    // === 4. UI Toggles & Feedback ===
    private bool IsLoading { get; set; } = true;
    private bool ShowCreateSongPanel { get; set; } = false;
    private List<ToastMessage> ToastMessages { get; set; } = new();

    // === 5. New Component Models ===
    // This feeds your SongCreateForm component
    private CreateSongModel NewCreateSongModel { get; set; } = new();

    // === 6. Component References (BlazorBootstrap / Library) ===
    private Grid<SongDTO> CurrentGrid = new();
    private RemoveSongModal RemoveSongModal = default!;
    private Modal MusicSearchModal = new();
    private BulkSongRemovalModal BulkSongRemovalModal = new();

    private IEnumerable<string> UploadErrorMessages { get; set; } = Enumerable.Empty<string>();
    private string UploadSuccessMessage { get; set; } = string.Empty;

    private async Task<GridDataProviderResult<SongDTO>> SongDataProvider(GridDataProviderRequest<SongDTO> request)
    {
        this.Songs = this.MasterSongList.ToList();
        if (!this.Songs.Any())
        {
            this.Songs = (await this.SongService.GetSongsByBandIDAsync(this.CurrentBandID));
            this.MasterSongList = this.Songs.ToList();
        }

        if (this.CurrentSongListTypeID > 0)
        {
            this.Songs = this.Songs.Where(s => s.SongListTypeID == this.CurrentSongListTypeID);
        }

        @if (!string.IsNullOrWhiteSpace(this.SearchForSongCriteria))
        {
            this.Songs = this.Songs.Where(s =>
                s.Artist.Contains(this.SearchForSongCriteria, StringComparison.OrdinalIgnoreCase) ||
                s.Title.Contains(this.SearchForSongCriteria, StringComparison.OrdinalIgnoreCase));
        }

        this.IsLoading = false;

        this.StateHasChanged();

        return request.ApplyTo(this.Songs);
    }

    protected override async Task OnInitializedAsync()
    {
        this.CurrentAccountID = await this.UserService.GetCurrentAccountIDAsync();

        this.CurrentBand = await this.BandService.GetDefaultBand(this.CurrentAccountID);
        this.CurrentBandID = this.CurrentBand?.BandID ?? 0;

        this.MasterSongList = (await this.SongService.GetSongsByBandIDAsync(this.CurrentBandID)).ToList();
        this.SongListTypes = (await this.SongListTypeService.GetBandIDAsync(this.CurrentBandID)).ToList();
        this.CurrentSongListTypeID = this.SongListTypes.FirstOrDefault()?.SongListTypeID ?? 0;
    }

    // === 2. Navigation & Grid State ===
    private async Task OnSongListTypeChanged(int songListTypeID)
    {
        this.CurrentSongListTypeID = songListTypeID;
        this.ClearSelectedTaskOption();
        await this.RefreshGrid();
    }

    private async Task RefreshGrid()
    {
        await this.CurrentGrid.RefreshDataAsync();
    }

    // === 3. Song Creation (Manual & Catalog) ===
    private void OnCreateNewSongClick() => this.ShowCreateSongPanel = true;

    private async Task OnCreateSong()
    {
        var newSong = await SongService.CreateAsync(new SongDTO
        {
            BandID = this.CurrentBandID,
            CreatedByAccountID = this.CurrentAccountID,
            SongListTypeID = this.CurrentSongListTypeID,
            Artist = this.NewCreateSongModel.Artist,
            Title = this.NewCreateSongModel.Title
        });

        this.MasterSongList.Add(newSong);
        this.SortMasterList();

        ShowToast(ToastType.Success, $"New song {newSong.Title} by {newSong.Artist} was created succesfully.");
        this.ClearNewSongRequest();
        await this.RefreshGrid();
    }

    private async Task HandleTrackSelected(SongDTO song)
    {
        var newSong = await SongService.CreateAsync(new SongDTO
        {
            BandID = this.CurrentBandID,
            CreatedByAccountID = this.CurrentAccountID,
            SongListTypeID = this.CurrentSongListTypeID,
            Artist = song.Artist,
            Title = song.Title
        });

        this.MasterSongList.Add(newSong);
        this.SortMasterList();

        var currentSongListTypeName = this.SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == this.CurrentSongListTypeID);
        this.ShowToast(ToastType.Success, $"{song.Title} was succesfully added to {currentSongListTypeName?.ListTypeName}.");

        await this.RefreshGrid();
    }

    private void OnCancelCreatingNewSong() => this.ClearNewSongRequest();

    private void ClearNewSongRequest()
    {
        this.NewCreateSongModel = new();
        this.ShowCreateSongPanel = false;
    }

    // === 4. Search & Filtering ===
    private async Task OnSearchForSongs(ChangeEventArgs e)
    {
        this.SearchForSongCriteria = e.Value?.ToString() ?? string.Empty;
        await this.RefreshGrid();
    }

    private async Task ClearSearchResults()
    {
        this.SearchForSongCriteria = string.Empty;
        await this.RefreshGrid();
    }

    private void SortMasterList()
    {
        this.MasterSongList = this.MasterSongList
            .OrderBy(s => s.Artist, StringComparer.OrdinalIgnoreCase)
            .ThenBy(s => s.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    // === 5. Bulk Actions (Move & Remove) ===
    private void ClearSelectedTaskOption() => this.SelectedTask = TaskOptions.Empty;

    private async Task OnChangeSongType(int targetTypeID)
    {
        //this will assign new ListTypeID (targetTypeID) to each song in SelectedSongs
        var createSongTasks = SelectedSongs.Select(s =>
        {
            s.SongListTypeID = targetTypeID;
            return SongService.UpdateAsync(s);
        });
        await Task.WhenAll(createSongTasks);

        var selectedSongType = this.SongListTypes.FirstOrDefault(slt => slt.SongListTypeID == targetTypeID);
        ShowToast(ToastType.Success, $"({createSongTasks.Count()}) songs were succesfully moved to {selectedSongType?.ListTypeName}.");
        this.ClearSelectedTaskOption();
        await this.RefreshGrid();
    }

    private async Task OnRemoveSelectedBulkSongsClick()
    {
        var tasks = SelectedSongs.Select(s => SongService.DeleteAsync(s.SongID));
        await Task.WhenAll(tasks);

        foreach (var song in SelectedSongs)
        {
            this.MasterSongList.Remove(song);
        }

        await BulkSongRemovalModal.HideAsync();
        ShowToast(ToastType.Danger, "The selected songs were succesfully removed.");
        this.ClearSelectedTaskOption();
        await this.RefreshGrid();
    }

    // === 6. Single Item Actions & Modals ===
    private async Task OnConfirmRemoveSongClick(SongDTO song)
    {
        this.CurrentSelectedSong = song;
        await this.RemoveSongModal.ShowAsync();
    }

    private async Task OnRemoveSelectedSongClick()
    {
        await SongService.DeleteAsync(CurrentSelectedSong.SongID);
        await RemoveSongModal.HideAsync();

        this.MasterSongList.Remove(CurrentSelectedSong);

        this.CurrentSelectedSong = new();

        await this.RefreshGrid();
    }

    private async Task OnOpenBulkSongRemovalModal() => await BulkSongRemovalModal.ShowAsync();
    private async Task OnHideBulkSongRemovalModalClick() => await BulkSongRemovalModal.HideAsync();
    private async Task OnSearchMusicCatalogClick() => await MusicSearchModal.ShowAsync();
    private async Task OnHideMusicSearchModalClick() => await MusicSearchModal.HideAsync();
    private async Task OnHideRemoveSongModalClick() => this.CurrentSelectedSong = new();

    // ==== File Upload === 
    private async Task HandleFileSelected(InputFileChangeEventArgs e, SongDTO songDTO, FileUploadType fileUploadType)
    {
        // isUploading = true;
        // statusMessage = string.Empty;

        UploadErrorMessages = new string[0];

        try
        {
            if (!FileValidator.IsExtensionAllowed(e.File.Name))
            {
                // Show error message to user
                //clear file upload
                this.UploadErrorMessages = new string[] { "Invalid file type" };
                return;
            }

            var maxFileSize = 1024 * 1024 * 10; // 10MB limit
            var file = e.File;
            using var stream = file.OpenReadStream(maxFileSize);
            var uploadResult = await BandResourceManager.UploadResourceAsync(
                bandId: CurrentBandID,
                fileName: file.Name,
                content: stream,
                contentType: file.ContentType
            );

            if (uploadResult.Errors?.Any() ?? false)
            {
                UploadErrorMessages = uploadResult.Errors;
                return;
            }

            switch (fileUploadType)
            {
                case FileUploadType.Tab:
                    songDTO.TabFileName = uploadResult.Url;
                    break;
                case FileUploadType.Lyric:
                    songDTO.LyricFileName = uploadResult.Url;
                    break;
                case FileUploadType.MP3:
                    songDTO.Mp3FileName = uploadResult.Url;
                    break;
                case FileUploadType.SheetMusic:
                    songDTO.SheetMusicFileName = uploadResult.Url;
                    break;
            }

            await this.SongService.UpdateAsync(songDTO);

            UploadSuccessMessage = $"File '{file.Name}' was uploaded successfully!";
        }
        catch (Exception ex)
        {
            //TODO: do not expose exception message to client
            UploadErrorMessages = new string[] { ex.Message };
        }
        finally
        {
            // isUploading = false;
            StateHasChanged();
        }
    }

    // === 7. Helpers ===
    private void ShowToast(ToastType type, string message)
    {
        this.ToastMessages.Add(new ToastMessage { Type = type, Message = message });
    }
}
