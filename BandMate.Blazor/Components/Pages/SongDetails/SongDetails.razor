@page "/song/details/{SongID:int}";
@using BandMate.Blazor.Components.Pages.SongDetails.Components
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAccountService AccountService
@inject IBandService BandService
@inject IMusicCatalogService MusicCatalogService
@inject ISongListTypeService SongListTypeService
@inject ISongService SongService
@inject IUserService UserService
@inject NavigationManager NavigationManager

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
    <div class="clearfix">
        <img src="images/Full_Logo_Green_PMS_U.svg" width="150" class="float-end" alt="Spotify Logo" />
        <div class="ms-5 ps-5">
            <PageHeader Title="Song Details" />
        </div>
    </div>

    <div class="container pb-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-lg text-white p-4"
                     style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border-radius: 20px;">
                    <SongDetailsNav SongID="@Song.SongID" />
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(ExternalAlbum?.AlbumImgCoverUrl))
                        {
                            <img src="@ExternalAlbum?.AlbumImgCoverUrl" class="img-fluid rounded-2 mb-3">
                        }
                        else
                        {
                            <div class="mx-auto my-3 rounded-2 rounded d-flex justify-content-center align-items-center shadow-lg"
                                 style="width: 250px; height: 250px; background: linear-gradient(145deg, #282828, #181818); border: 1px solid rgba(255,255,255,0.1);">
                                <span class="bi bi-music-note-beamed display-4 text-secondary opacity-75"></span>
                            </div>
                        }
                        <h2 class="fw-bold text-black-50">@Song.Title</h2>
                        <div class="text-black-50 fs-3">@Song.Artist</div>
                    </div>
                    <div class="row g-3 text-dark">
                        <SongDetailsGridItem FieldName="Created By" FieldValue="@CreatedByAccountName" />
                        <SongDetailsGridItem FieldName="Created Date" FieldValue="@Song.CreatedDateForDisplay" />
                        <SongDetailsGridItem FieldName="Song Type" FieldValue="@SongTypeName" />
                        <SongDetailsGridItem FieldName="BPM" FieldValue="@Song.Bpm.ToString()" />
                        <SongDetailsGridItem FieldName="Key Signature" FieldValue="@Song.KeySignature" />
                        <SongDetailsGridItem FieldName="Mp3 File" FieldValue="@Song.Mp3FileName" FieldValueIsFile="true" />
                        <SongDetailsGridItem FieldName="Tab File" FieldValue="@Song.TabFileName" FieldValueIsFile="true" />
                        <SongDetailsGridItem FieldName="Lyric File" FieldValue="@Song.LyricFileName" FieldValueIsFile="true" />
                        <SongDetailsGridItem FieldName="Sheet Music File" FieldValue="@Song.SheetMusicFileName" FieldValueIsFile="true" />
                        <SongDetailsGridItem FieldName="Youtube Url" FieldValue="@Song.YoutubeURL" FieldValueIsLink="true" />
                        <SongDetailsGridItem FieldName="Sheet Music Url" FieldValue="@Song.SheetMusicURL" FieldValueIsLink="true" />
                        <SongDetailsGridItem FieldName="Lyric Url" FieldValue="@Song.LyricURL" FieldValueIsLink="true" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int SongID { get; set; }

    private SongDTO Song { get; set; }
    private BandDTO CurrentBand { get; set; } = new();
    private int CurrentBandID { get; set; } = 0;
    private int CurrentAccountID { get; set; } = 0;

    private bool IsLoading { get; set; } = true;

    private string SongTypeName { get; set; } = string.Empty;

    private AlbumDTO ExternalAlbum { get; set; } = new();

    private string CreatedByAccountName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        CurrentAccountID = await UserService.GetCurrentAccountIDAsync();

        CurrentBand = await BandService.GetDefaultBand(CurrentAccountID);
        CurrentBandID = CurrentBand?.BandID ?? 0;

        //these are all the songs the user has access to with the current band they are viewing
        var songs = (await SongService.GetSongsByBandIDAsync(CurrentBandID)).ToList();

        Song = songs.FirstOrDefault(s => s.SongID == SongID);
        if (Song is null)
        {
            //not authorized to view this song
            NavigationManager.NavigateTo("/");
        }

        var songListTypes = (await this.SongListTypeService.GetBandIDAsync(this.CurrentBandID)).ToList();
        SongTypeName = songListTypes.FirstOrDefault(slt => slt.SongListTypeID == Song.SongListTypeID)?.ListTypeName;

        if (!string.IsNullOrEmpty(Song.ExternalAlbumID))
        {
            ExternalAlbum = await MusicCatalogService.GetAlbumAsync(Song.ExternalAlbumID);
        }

        var accounts = await AccountService.GetAllByBandID(CurrentBandID);
        var createdByAccount = accounts.FirstOrDefault(a => a.AccountID == Song.CreatedByAccountID);
        if (createdByAccount is not null)
        {
            CreatedByAccountName = $"{createdByAccount.FirstName} {createdByAccount.LastName}";
        }

        IsLoading = false;
    }
}