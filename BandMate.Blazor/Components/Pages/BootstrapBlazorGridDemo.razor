@page "/bootstrap-blazor-grid-demo"
@rendermode InteractiveServer
@inject ISongService SongService

<h1>{ YOUR BAND NAME }</h1>

<h2>@Songs.Count() Songs</h2>

<Button Color="Color.Danger"
        Icon="fa-solid fa-trash-can"
        IsOutline="true"
        OnClick="@(async () => await OnSongListTypeChanged(3))" />

<Table @ref="CurrentTable"
       TItem="SongDTO" 
       IsBordered="true" 
       IsStriped="true"
       TableSize="TableSize.Normal" 
       IsMultipleSelect="true"
       OnQueryAsync="OnQueryAsync"
       PageItems="200"
       IsPagination="false">
    <TableColumns>
        <TableColumn @bind-Field="@context.Artist" Filterable="true" Sortable="true" />
        <TableColumn @bind-Field="@context.Title" Filterable="true" Sortable="true" />
        <TableColumn @bind-Field="@context.CreatedDateForDisplay" Filterable="true" Sortable="true" />
        <TableColumn 
            TItem="SongDTO" 
            TType="int" 
            Text="Actions" 
            Align="Alignment.Center" 
            FieldName="@(nameof(SongDTO.SongID))">

            <Template Context="song">
                <div class="btn-group">
                    <Button Color="Color.Danger" 
                            Icon="fa-solid fa-trash-can" 
                            IsOutline="true"
                            OnClick="@(async () => await OnDeleteSongClicked(song.Row))" />
                </div>
            </Template>
        </TableColumn>
    </TableColumns>
</Table>

@code {
    private IQueryable<SongDTO> Songs { get; set; } = Enumerable.Empty<SongDTO>().AsQueryable();
    private IEnumerable<SongDTO> MasterSongList { get; set; } = Enumerable.Empty<SongDTO>().ToList();
    private int CurrentSongListTypeID { get; set; } = 0;
    private Table<SongDTO> CurrentTable;

    private async Task<QueryData<SongDTO>> OnQueryAsync(QueryPageOptions options)
    {
        var hardCodedBandID = 2;

        this.Songs = this.MasterSongList.ToList().AsQueryable();
        if (!this.Songs.Any())
        {
            this.Songs = (await this.SongService.GetSongsByBandIDAsync(hardCodedBandID)).AsQueryable();

            this.MasterSongList = this.Songs.ToList();
        }

        if (this.CurrentSongListTypeID > 0)
        {
            this.Songs = this.Songs.Where(s => s.SongListTypeID == this.CurrentSongListTypeID);
        }

        this.StateHasChanged();

        return new QueryData<SongDTO>()
        {
            Items = this.Songs.ToList(),
            TotalCount = this.Songs.Count()
        };
    }

    private async Task RefreshTable()
    {
        await this.CurrentTable.QueryAsync(); //calling this to trigger a method that will cause the table items to update, otherwise won't update
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var hardCodedBandID = 2;
            this.MasterSongList = (await this.SongService.GetSongsByBandIDAsync(hardCodedBandID)).ToList();
        }
    }

    private async Task OnSongListTypeChanged(int songListTypeID)
    {
        this.CurrentSongListTypeID = songListTypeID;
        await this.RefreshTable();
    }

    private async Task OnDeleteSongClicked(SongDTO song)
    {
        
    }
}
